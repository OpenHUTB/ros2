<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>underwater_sonar_mapping</name>
  <version>0.1.0</version>
  <description>Synthetic underwater sonar mapping and obstacle visualization.</description>
  <maintainer email="noreply@openhutb.github.io">OpenHUTB</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>python3-numpy</depend>
  <depend>python3-matplotlib</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>