<launch>
  <!-- ============================================================
       vehicle_pygame_teleop 统一启动入口
         roslaunch vehicle_pygame_teleop main.launch

       启动后弹出 pygame 二维模拟窗口，点击窗口使其获得键盘焦点即可控制车辆；
       节点同时按 publish_hz 向 cmd_vel 话题发布 geometry_msgs/Twist。

       前置依赖：sudo apt install -y python3-pygame
       ============================================================ -->

  <arg name="cmd_vel_topic"        default="/cmd_vel" doc="速度指令话题，与仿真器遥控接口保持一致"/>
  <arg name="publish_hz"           default="30.0"     doc="/cmd_vel 发布频率 Hz"/>
  <arg name="max_speed"            default="1.5"      doc="最大前进速度 m/s"/>
  <arg name="max_reverse"          default="0.8"      doc="最大倒车速度 m/s"/>
  <arg name="accel"                default="2.2"      doc="油门 / 倒车加速度 m/s^2"/>
  <arg name="brake"                default="4.5"      doc="刹车减速度 m/s^2"/>
  <arg name="handbrake"            default="8.0"      doc="空格手刹减速度 m/s^2"/>
  <arg name="drag"                 default="1.2"      doc="无按键时滑行阻力减速度 m/s^2"/>
  <arg name="max_yaw_rate"         default="1.4"      doc="最大偏航角速度 rad/s（左转为正）"/>
  <arg name="yaw_response"         default="8.0"      doc="转向响应角加速度 rad/s^2"/>
  <arg name="reverse_steer_invert" default="true"     doc="倒车时转向效果反向（差速底盘特性）"/>

  <!-- 先加载 yaml 里的默认值，再用下面的 <param> 覆盖成 launch 参数，
       因此 `roslaunch ... max_speed:=3.0` 这类命令行覆盖生效。 -->
  <rosparam command="load" file="$(find vehicle_pygame_teleop)/config/vehicle_pygame_teleop.yaml"/>

  <param name="topic/cmd_vel"               value="$(arg cmd_vel_topic)"/>
  <param name="rate/publish_hz"             value="$(arg publish_hz)"/>
  <param name="vehicle/max_speed"           value="$(arg max_speed)"/>
  <param name="vehicle/max_reverse"         value="$(arg max_reverse)"/>
  <param name="vehicle/accel"               value="$(arg accel)"/>
  <param name="vehicle/brake"               value="$(arg brake)"/>
  <param name="vehicle/handbrake"           value="$(arg handbrake)"/>
  <param name="vehicle/drag"                value="$(arg drag)"/>
  <param name="vehicle/max_yaw_rate"        value="$(arg max_yaw_rate)"/>
  <param name="vehicle/yaw_response"        value="$(arg yaw_response)"/>
  <param name="vehicle/reverse_steer_invert" value="$(arg reverse_steer_invert)"/>

  <!-- 入口为 main.py（作业要求每模块入口为 main.*）；键盘由 pygame 直接
       从窗口事件读取，无需 xterm 转发，所以不加 launch-prefix。 -->
  <node pkg="vehicle_pygame_teleop" type="main.py" name="vehicle_pygame_teleop" output="screen"/>
</launch>
