Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Image
      Name: Heatmap
      Topic:
        Value: /rov/heatmap
      Enabled: true
    - Class: rviz_default_plugins/Image
      Name: Ocean Current
      Topic:
        Value: /rov/ocean_current
      Enabled: true
    - Class: rviz_default_plugins/Path
      Name: Planned Path
      Topic:
        Value: /rov/planned_path
      Color: 255; 255; 0
      Enabled: true
  Global Options:
    Background Color: 30; 30; 40
    Fixed Frame: world
  Name: root
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 60
      Name: Current View
      Pitch: 0.1
      Target Frame: world
      Yaw: 0.0
Window Geometry:
  Height: 800
  Width: 1200
