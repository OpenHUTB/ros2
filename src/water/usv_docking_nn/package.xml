<?xml version="1.0"?>
<package format="2">
  <name>usv_docking_nn</name>
  <version>0.1.0</version>
  <description>
    MuJoCo 无人艇自主靠泊：激光雷达 + 神经网络末段对准控制，ROS Noetic 封装。
    注意：MuJoCo 本体通过 pip 安装（pip3 install mujoco==3.2.3），不属于 rosdep 可解析依赖，
    完整安装命令见 README。
  </description>

  <maintainer email="2789697997@qq.com">jydw121</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>rospkg</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
</package>
