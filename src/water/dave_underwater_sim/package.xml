<?xml version="1.0"?>
<package format="3">
  <name>dave_underwater_sim</name>
  <version>0.1.0</version>
  <description>DAVE 水下机器人仿真环境搭建与 REXROV/Oberon7 机械臂作业演示（ROS 1 Noetic + Gazebo 包装）</description>
  <maintainer email="Chenjunhua-Dotcom@users.noreply.github.com">Chenjunhua-Dotcom</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <!-- 本包是 ROS 2 封装层；实际仿真依赖 ROS 1 Noetic desktop-full + Gazebo 11，
       无法用 ROS 2 的 rosdep 键表达，安装方法见 install_dave.sh / README。 -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
