<?xml version="1.0"?>
<sdf version="1.6">
<world name="default">
<!-- 水下环境全局配置 -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>10</iters>
        </solver>
      </ode>
    </physics>
    <!-- 水下场景光效与雾效 -->
    <scene>
      <ambient>0.12 0.22 0.32 1</ambient>
      <background>0.06 0.16 0.28 1</background>
      <shadows>false</shadows>
      <fog>
        <type>linear</type>
        <color>0.06 0.16 0.28 1</color>
        <density>0.35</density>
        <start>1.5</start>
        <end>18</end>
      </fog>
    </scene>
<!-- 模型状态服务 提供set_model_state控制接口 -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>100.0</update_rate>
    </plugin>
    
  <!-- 地面 -->
  <model name="ground">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
      </collision>
      <visual name="visual">
        <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        <material>
          <ambient>0.22 0.26 0.2 1</ambient>
          <diffuse>0.3 0.34 0.26 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
  
<!-- AUV 水下机器人 -->
    <model name="auv">
      <pose>0 0 0.3 0 0 0</pose>
      <link name="base_link">
        <inertial>
          <mass>5.0</mass>
          <inertia>
            <ixx>0.1</ixx>
            <iyy>0.1</iyy>
            <izz>0.05</izz>
          </inertia>
        </inertial>
        
        <!-- 水下流体速度衰减（水阻）：模拟水体阻尼感，加减速更平缓 -->
        <velocity_decay>
          <linear>0.99 0.99 0.99</linear>
          <angular>1.05 1.05 1.05</angular>
        </velocity_decay>
        <collision name="base_collision">
          <geometry><box><size>1.0 0.6 0.4</size></box></geometry>
        </collision>
        <visual name="base_visual">
          <geometry><box><size>1.0 0.6 0.4</size></box></geometry>
          <material>
            <ambient>0.1 0.3 0.8 1</ambient>
            <diffuse>0.2 0.4 0.9 1</diffuse>
          </material>
        </visual>
<!-- 前置相机 -->
      <sensor name="camera" type="camera">
          <pose>0.55 0 0 0 0 0</pose>
          <always_on>true</always_on>
  	  <update_rate>20</update_rate>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>50</far>
            </clip>
          </camera>
          <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/auv/camera</namespace>
            </ros>
            <camera_name>camera</camera_name>
            <frame_name>base_link</frame_name>
          </plugin>
        </sensor>
      </link>
      <!-- 平面运动驱动 控制x/y平移，锁定深度0.3m -->
      <plugin name="planar_move" filename="libgazebo_ros_planar_move.so">
        <ros>
          <namespace>/auv</namespace>
        </ros>
        <link_name>base_link</link_name>
        <topic_name>cmd_vel</topic_name>
        <odom_topic>odom</odom_topic>
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <publish_odom>true</publish_odom>
        <publish_tf>true</publish_tf>
        <!-- 锁定运行深度，彻底解决上浮问题 -->
        <distance>0.3</distance>
      </plugin>
    </model>
 
</world>
</sdf>

