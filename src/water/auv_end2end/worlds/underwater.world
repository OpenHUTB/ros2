<?xml version="1.0"?>
<sdf version="1.6">
<world name="default">
  <!-- /clock 由 launch 里的 gzserver -s libgazebo_ros_init.so 提供 -->
  <!-- 中性浮力：水下机器人整机密度≈水体，这里直接关闭重力，
       避免模型下沉贴地后被地面摩擦拖住，导致指令速度无法兑现 -->
  <gravity>0 0 0</gravity>
  <!-- 水下环境全局配置 -->
  <physics type="ode">
    <max_step_size>0.001</max_step_size>
    <real_time_factor>1</real_time_factor>
    <ode>
      <solver>
        <type>quick</type>
        <iters>10</iters>
      </solver>
    </ode>
  </physics>

  <!-- 水下场景光效与雾效 -->
  <scene>
    <ambient>0.12 0.22 0.32 1</ambient>
    <background>0.06 0.16 0.28 1</background>
    <shadows>false</shadows>
    <fog>
      <type>linear</type>
      <color>0.06 0.16 0.28 1</color>
      <density>0.35</density>
      <start>1.5</start>
      <end>18</end>
    </fog>
  </scene>

  <!-- 地面 -->
  <model name="ground">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
      </collision>
      <visual name="visual">
        <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        <material>
          <ambient>0.22 0.26 0.2 1</ambient>
          <diffuse>0.3 0.34 0.26 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

    <!-- AUV 水下机器人 -->
  <model name="auv">
    <pose>0 0 0.3 0 0 0</pose>
    <link name="base_link">
      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.1</ixx>
          <iyy>0.1</iyy>
          <izz>0.05</izz>
        </inertia>
      </inertial>
      <!-- 注意：SDF 的 velocity_decay 单位是「每秒衰减比例」，
           填 0.997 等于每秒丢掉 99.7% 的速度，模型几乎不动；
           这里不启用速度衰减，速度完全由 cmd_vel 决定 -->
      <collision name="base_collision">
        <geometry><box><size>1.0 0.6 0.4</size></box></geometry>
      </collision>
      <visual name="base_visual">
        <geometry><box><size>1.0 0.6 0.4</size></box></geometry>
        <material>
          <ambient>0.1 0.3 0.8 1</ambient>
          <diffuse>0.2 0.4 0.9 1</diffuse>
        </material>
      </visual>
      <!-- 前置相机 -->
      <sensor name="camera" type="camera">
        <pose>0.55 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>50</far>
          </clip>
        </camera>
        <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/auv/camera</namespace>
          </ros>
          <camera_name>camera</camera_name>
          <frame_name>base_link</frame_name>
        </plugin>
      </sensor>
    </link>

    <plugin name="planar_move" filename="libgazebo_ros_planar_move.so">
      <ros>
        <namespace>/auv</namespace>
      </ros>
      <link_name>base_link</link_name>
      <topic_name>cmd_vel</topic_name>
      <odom_topic>odom</odom_topic>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_tf>true</publish_tf>
    </plugin>
  </model>


  <!-- ========== 测试障碍物：双向避障测试组 ========== -->
  <!-- 正前方第一道竖墙 -->
  <model name="wall_front">
    <static>true</static>
    <pose>4 0 0.75 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.2 2 1.5</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.2 2 1.5</size></box></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <!-- 右前方障碍物（测试左避障） -->
  <model name="wall_right">
    <static>true</static>
    <pose>8 -1.5 0.75 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>2 0.2 1.5</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>2 0.2 1.5</size></box></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <!-- 左前方障碍物（测试右避障） -->
  <model name="wall_left">
    <static>true</static>
    <pose>12 1.5 0.75 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>2 0.2 1.5</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>2 0.2 1.5</size></box></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <!-- 交错障碍物组（测试连续双向切换避障） -->
  <model name="wall_mid1">
    <static>true</static>
    <pose>16 -1 0.75 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>1 0.2 1.5</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>1 0.2 1.5</size></box></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <model name="wall_mid2">
    <static>true</static>
    <pose>18 1 0.75 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>1 0.2 1.5</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>1 0.2 1.5</size></box></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <!-- 第二组错位墙体：验证连续避让与冷却后重复触发 -->
  <model name="wall_far1">
    <static>true</static>
    <pose>24 -1.2 0.75 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>1.2 0.2 1.5</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>1.2 0.2 1.5</size></box></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <model name="wall_far2">
    <static>true</static>
    <pose>28 1.2 0.75 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>1.2 0.2 1.5</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>1.2 0.2 1.5</size></box></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <model name="wall_far3">
    <static>true</static>
    <pose>32 -0.8 0.75 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>1.2 0.2 1.5</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>1.2 0.2 1.5</size></box></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

</world>
</sdf>

