<mujoco model="rov_docking_pool">
  <option timestep="0.002" gravity="0 0 -2"/>
  <default><geom condim="1" friction="0.1 0.1 0.1" density="200"/></default>
  <asset>
    <texture builtin="checker" rgb1="0.2 0.25 0.3" rgb2="0.1 0.12 0.15" width="256" height="256" name="ft"/>
    <material texture="ft" texrepeat="8 8" name="fm"/>
  </asset>
  <worldbody>
    <light pos="0 0 6" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="5 5 0.1" material="fm"/>
    <!-- 对接站：圆柱形基座 + 上方对接标记柱 -->
    <geom name="dock_base" type="cylinder" pos="3.0 0.0 0.1" size="0.4 0.1" rgba="0.5 0.5 0.5 1"/>
    <geom name="dock_marker" type="cylinder" pos="3.0 0.0 0.5" size="0.08 0.4" rgba="1.0 0.8 0.0 1"/>
    <!-- 障碍物 -->
    <geom name="obs1" type="box" pos="1.5 1.5 0.2" size="0.3 0.3 0.2" rgba="0.3 0.3 0.3 1"/>
    <geom name="obs2" type="box" pos="1.5 -1.5 0.2" size="0.3 0.3 0.2" rgba="0.3 0.3 0.3 1"/>
    <body name="rov" pos="0.0 0.0 0.5">
      <freejoint/>
      <geom name="hull" type="box" size="0.25 0.15 0.08" rgba="0.2 0.5 0.8 1"/>
      <camera name="forward_cam" pos="0.26 0.0 0.05" euler="0.0 90.0 0.0" fovy="60"/>
    </body>
  </worldbody>
</mujoco>
