<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rov_ballast_trim</name>
  <version>0.1.0</version>
  <description>
    ROV 浮力-压载配平与初稳性核算：由外壳排水体积与部件质量表算中性浮力、
    重心/浮心偏心、初稳心高 GM、横摇周期与允许扰动力矩，并反解压载质量与安装位置。
    全潜状态按 GM = z_B - z_G 计算（不含水面船的 BM = I/V 项）。纯标准库实现，不依赖 rclpy。
  </description>
  <!-- 提交前把 maintainer 改成你自己的名字与邮箱 -->
  <maintainer email="openhutb@example.org">OpenHUTB</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>launch</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
