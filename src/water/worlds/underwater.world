<?xml version="1.0"?>
<sdf version="1.6">
  <world name="underwater">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
        </solver>
      </ode>
    </physics>

    <scene>
      <ambient>0.1 0.1 0.1 1</ambient>
      <background>0.05 0.15 0.25 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.1 0.1 -0.9</direction>
    </light>

    <!-- 海底平面 -->
    <model name="seabed">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/DarkGrey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ROV 载体：演示场景设为静态，避免无浮力/推进器时沉到海底导致相机贴住海床 -->
    <model name="rov">
      <static>true</static>
      <pose>0 0 2 0 0 0</pose>
      <link name="base_link">
        <inertial>
          <mass>10</mass>
          <inertia>
            <ixx>0.1</ixx>
            <iyy>0.1</iyy>
            <izz>0.1</izz>
          </inertia>
        </inertial>
        <visual name="body">
          <geometry>
            <box>
              <size>0.8 0.4 0.3</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Blue</name>
            </script>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.8 0.4 0.3</size>
            </box>
          </geometry>
        </collision>
      </link>

      <link name="sonar_camera_link">
        <pose>0.4 0 0 0 0 0</pose>
        <visual name="cam_vis">
          <geometry>
            <box>
              <size>0.1 0.1 0.1</size>
            </box>
          </geometry>
        </visual>
        <sensor name="sonar_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>20</far>
            </clip>
          </camera>
          <!-- 实际话题 = 命名空间 + camera_name + /image_raw = /sonar/camera/image_raw -->
          <plugin name="camera_plugin" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/sonar</namespace>
            </ros>
            <camera_name>camera</camera_name>
            <frame_name>sonar_camera_link</frame_name>
          </plugin>
        </sensor>
      </link>

      <joint name="cam_joint" type="fixed">
        <parent>base_link</parent>
        <child>sonar_camera_link</child>
      </joint>
    </model>

    <!-- 目标：管道 -->
    <model name="pipe_target">
      <static>true</static>
      <pose>3 0 2 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>2.0</length>
            </cylinder>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Orange</name>
            </script>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
