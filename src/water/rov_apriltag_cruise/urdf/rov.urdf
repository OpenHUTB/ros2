<?xml version="1.0"?>
<robot name="rov">
  <material name="rov_orange">
    <color rgba="0.95 0.45 0.08 1"/>
  </material>
  <material name="rov_dark">
    <color rgba="0.12 0.13 0.15 1"/>
  </material>
  <material name="rov_yellow">
    <color rgba="0.98 0.82 0.15 1"/>
  </material>

  <link name="base_link">
    <inertial>
      <mass value="10.0"/>
      <inertia ixx="0.171" ixy="0" ixz="0" iyy="0.215" iyz="0" izz="0.340"/>
    </inertial>
    <visual name="hull">
      <geometry>
        <box size="0.78 0.56 0.36"/>
      </geometry>
      <material name="rov_orange"/>
    </visual>
    <visual name="deck">
      <origin xyz="-0.02 0 0.20"/>
      <geometry>
        <box size="0.46 0.36 0.05"/>
      </geometry>
      <material name="rov_yellow"/>
    </visual>
    <visual name="skid_left">
      <origin xyz="0 0.30 -0.22"/>
      <geometry>
        <box size="0.70 0.04 0.05"/>
      </geometry>
      <material name="rov_dark"/>
    </visual>
    <visual name="skid_right">
      <origin xyz="0 -0.30 -0.22"/>
      <geometry>
        <box size="0.70 0.04 0.05"/>
      </geometry>
      <material name="rov_dark"/>
    </visual>
    <collision name="hull_collision">
      <geometry>
        <box size="0.78 0.56 0.36"/>
      </geometry>
    </collision>
  </link>

  <link name="camera_link">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
    <visual name="camera_body">
      <origin rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.07" length="0.14"/>
      </geometry>
      <material name="rov_dark"/>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.40 0 0.02" rpy="0 0 0"/>
  </joint>

  <!-- 四个推进器 -->
  <link name="thruster_fl">
    <inertial><mass value="0.4"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    <visual name="v"><geometry><cylinder radius="0.07" length="0.14"/></geometry><material name="rov_dark"/></visual>
  </link>
  <joint name="thruster_fl_joint" type="fixed"><parent link="base_link"/><child link="thruster_fl"/><origin xyz="0.30 0.26 -0.12" rpy="0 1.5708 0"/></joint>
  <link name="thruster_fr">
    <inertial><mass value="0.4"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    <visual name="v"><geometry><cylinder radius="0.07" length="0.14"/></geometry><material name="rov_dark"/></visual>
  </link>
  <joint name="thruster_fr_joint" type="fixed"><parent link="base_link"/><child link="thruster_fr"/><origin xyz="0.30 -0.26 -0.12" rpy="0 1.5708 0"/></joint>
  <link name="thruster_rl">
    <inertial><mass value="0.4"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    <visual name="v"><geometry><cylinder radius="0.07" length="0.14"/></geometry><material name="rov_dark"/></visual>
  </link>
  <joint name="thruster_rl_joint" type="fixed"><parent link="base_link"/><child link="thruster_rl"/><origin xyz="-0.30 0.26 -0.12" rpy="0 1.5708 0"/></joint>
  <link name="thruster_rr">
    <inertial><mass value="0.4"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    <visual name="v"><geometry><cylinder radius="0.07" length="0.14"/></geometry><material name="rov_dark"/></visual>
  </link>
  <joint name="thruster_rr_joint" type="fixed"><parent link="base_link"/><child link="thruster_rr"/><origin xyz="-0.30 -0.26 -0.12" rpy="0 1.5708 0"/></joint>

  <!-- 相机传感器：640x480，70 度水平视场 -->
  <gazebo reference="camera_link">
    <sensor type="camera" name="rov_camera">
      <update_rate>30</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>1.22</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>40.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.004</stddev>
        </noise>
      </camera>
      <plugin name="rov_camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/rov</namespace>
          <remapping>image_raw:=camera/image_raw</remapping>
          <remapping>camera_info:=camera/camera_info</remapping>
        </ros>
        <camera_name>camera</camera_name>
        <frame_name>camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
</robot>
