<launch>
  <group ns="turtlesim1">
    <node pkg="turtlesim" type="turtlesim_node" name="sim" output="screen"/>
    <node pkg="rostopic" type="rostopic" name="circle_cmd" output="screen"
          args="pub -r 10 /turtlesim1/turtle1/cmd_vel geometry_msgs/Twist '{linear: {x: 2.0}, angular: {z: 1.8}}'"/>
  </group>
  <group ns="turtlesim2">
    <node pkg="turtlesim" type="turtlesim_node" name="sim" output="screen"/>
    <node pkg="rostopic" type="rostopic" name="circle_cmd" output="screen"
          args="pub -r 10 /turtlesim2/turtle1/cmd_vel geometry_msgs/Twist '{linear: {x: 1.5}, angular: {z: -1.2}}'"/>
  </group>
</launch>
