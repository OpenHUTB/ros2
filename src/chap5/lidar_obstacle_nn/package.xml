<?xml version="1.0"?>
<package format="3">
  <name>lidar_obstacle_nn</name>
  <version>0.1.0</version>
  <description>
    ROS 2 Humble neural network module that classifies LiDAR scans
    into obstacle proximity categories (near / far / free) using a
    small PyTorch MLP trained on Gazebo Fortress simulation data.
  </description>

  <maintainer email="maintainer@example.com">OpenHUTB contributor</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_sim_demos</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
