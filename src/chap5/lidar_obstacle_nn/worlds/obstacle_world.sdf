<?xml version="1.0" ?>
<!--
  Gazebo Fortress (Ignition Gazebo 6.x) world for the lidar_obstacle_nn
  module.

  Layout:
      - A 20x20 m ground plane.
      - A box-shaped robot ("lidar_box") at the origin carrying a
        360-beam 2D LiDAR with a 30 m range and 5 Hz update.
      - Three obstacles at different radii around the robot so that
        rotating the box lets the lidar see all three classes
        (near / far / free) automatically:
              * red   box at ~0.6 m  (near)
              * green box at ~1.8 m  (far)
              * blue  box at ~5.0 m  (free, only visible when rotated)

  The lidar publishes on the Gazebo topic "/scan", which the
  ros_gz parameter_bridge forwards to ROS 2 /scan
  (sensor_msgs/LaserScan).
-->
<sdf version="1.8">
  <world name="lidar_obstacle_world">
    <plugin
      filename="ignition-gazebo-physics-system"
      name="ignition::gazebo::systems::Physics"/>
    <plugin
      filename="ignition-gazebo-user-commands-system"
      name="ignition::gazebo::systems::UserCommands"/>
    <plugin
      filename="ignition-gazebo-scene-broadcaster-system"
      name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin
      filename="ignition-gazebo-sensors-system"
      name="ignition::gazebo::systems::Sensors"/>

    <!-- Simulation clock: 1 ms physics step, real time. -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.9 1</background>
    </scene>

    <!-- Sun (so GPU lidar / camera effects look reasonable) -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.9</constant>
      </attenuation>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <!-- Ground -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 1: NEAR (red), ~0.6 m in front of the robot. -->
    <model name="obstacle_near">
      <static>true</static>
      <pose>0.6 0 0.25 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.4 0.4 0.5</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>0.4 0.4 0.5</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Obstacle 2: FAR (green), ~1.8 m to the left of the robot. -->
    <model name="obstacle_far">
      <static>true</static>
      <pose>0 1.8 0.25 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.5 0.5 0.5</size></box>
          </geometry>
          <material>
            <ambient>0.1 0.8 0.1 1</ambient>
            <diffuse>0.1 0.8 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>0.5 0.5 0.5</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Obstacle 3: out of range (blue), ~5 m behind the robot. -->
    <model name="obstacle_distant">
      <static>true</static>
      <pose>-5 0 0.25 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.5 0.5 0.5</size></box>
          </geometry>
          <material>
            <ambient>0.1 0.2 0.8 1</ambient>
            <diffuse>0.1 0.2 0.8 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>0.5 0.5 0.5</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Robot: a box carrying a 360-beam 2D LiDAR. static=true so it
         stays at the origin (gravity would otherwise drop it through
         the ground plane or send it drifting before the lidar can
         publish a stable scan). z=0.05 keeps the lidar beam (at
         z = 0.05 + 0.06 = 0.11 m) inside the obstacle height range
         (0 - 0.5 m) so the horizontal scan actually hits the boxes. -->
    <model name="lidar_box">
      <static>true</static>
      <pose>0 0 0.05 0 0 0</pose>
      <link name="base_link">
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.01</iyy><iyz>0</iyz>
            <izz>0.01</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <box><size>0.2 0.2 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.1 1</ambient>
            <diffuse>0.7 0.7 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>0.2 0.2 0.1</size></box>
          </geometry>
        </collision>
      </link>

      <!-- 2D LiDAR sensor. Publishes on Gazebo topic "/scan". -->
      <link name="lidar_link">
        <pose>0 0 0.06 0 0 0</pose>
        <sensor name="gpu_lidar" type="gpu_lidar">
          <topic>scan</topic>
          <update_rate>5</update_rate>
          <lidar>
            <scan>
              <horizontal>
                <!-- 360 beams covering the full 360 degree FOV. -->
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.05</min>
              <max>30.0</max>
              <resolution>0.02</resolution>
            </range>
          </lidar>
          <always_on>true</always_on>
          <visualize>true</visualize>
        </sensor>
      </link>

      <!-- Joint connecting base_link to lidar_link. -->
      <joint name="lidar_joint" type="fixed">
        <parent>base_link</parent>
        <child>lidar_link</child>
      </joint>
    </model>

  </world>
</sdf>
