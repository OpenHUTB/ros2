<?xml version="1.0"?>
<sdf version="1.6">
  <model name="face_board">
    <static>true</static>
    <link name="board">
      <pose>0 0 0 0 0 0</pose>

      <visual name="face">
        <geometry>
          <box>
            <size>0.02 0.5 0.62</size>
          </box>
        </geometry>
        <!-- 使用 OGRE 材质脚本 + 高对比度人脸纹理（不依赖场景光照，醒目可见） -->
        <material>
          <script>
            <uri>model://face_board/materials/scripts</uri>
            <uri>model://face_board/materials/textures</uri>
            <name>face_board/face</name>
          </script>
        </material>
      </visual>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.02 0.5 0.62</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
