<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>reacher_track</name>
  <version>0.0.1</version>
  <description>在 MuJoCo 机械臂（Reacher）环境中，用纯 NumPy 神经网络实现"感知 -> 控制 -> 目标跟踪"闭环：关节编码器+目标检测提供感知，MLP 神经网络直接输出关节扭矩</description>
  <maintainer email="3248146937@qq.com">6lebron23</maintainer>
  <license>MIT</license>
  <exec_depend>python3</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <!-- mujoco 没有 rosdep key，需 pip 安装：python3 -m pip install 'mujoco>=3.1' -->
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
