<mujoco model="hand eye calibration scene">
  <!-- Hand-eye calibration scene written for this module; includes panda_pick.xml,
       a modified copy of MuJoCo Menagerie franka_emika_panda/panda.xml (Apache-2.0). -->
  <include file="panda_pick.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20" offwidth="1280" offheight="960"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.28 0.42 0.60" rgb2="0.02 0.02 0.04"
             width="256" height="1536"/>
    <texture type="2d" name="floor_tex" builtin="checker" mark="edge"
             rgb1="0.22 0.24 0.28" rgb2="0.14 0.15 0.18" markrgb="0.55 0.55 0.55"
             width="300" height="300"/>
    <material name="floor_mat" texture="floor_tex" texuniform="true" texrepeat="8 8" reflectance="0.15"/>
    <material name="board_mat" rgba="0.94 0.94 0.96 1" specular="0.2" shininess="0.2"/>
    <material name="red_dot" rgba="0.95 0.05 0.05 1" emission="0.35"/>
    <material name="green_dot" rgba="0.05 0.85 0.15 1" emission="0.35"/>
    <material name="blue_dot" rgba="0.05 0.20 0.95 1" emission="0.35"/>
    <material name="yellow_dot" rgba="0.98 0.85 0.05 1" emission="0.35"/>
    <material name="magenta_dot" rgba="0.90 0.05 0.85 1" emission="0.35"/>
  </asset>

  <worldbody>
    <light pos="0.2 -0.6 2.2" dir="0 0 -1" directional="true" diffuse="0.7 0.7 0.7"/>
    <light pos="1.2 -1.3 1.5" diffuse="0.5 0.5 0.5"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="floor_mat"/>

    <!-- calibration board on the ground -->
    <body name="calib_board" pos="0.55 0 0">
      <geom name="board_geom" type="box" size="0.145 0.145 0.006" pos="0 0 0.006" material="board_mat"/>
      <!-- 5 colored dots, known board-frame coordinates -->
      <geom name="dot_rg" type="sphere" size="0.012" pos="0.105 0.105 0.018" material="red_dot"
            contype="0" conaffinity="0"/>
      <geom name="dot_g" type="sphere" size="0.012" pos="0.105 -0.105 0.018" material="green_dot"
            contype="0" conaffinity="0"/>
      <geom name="dot_b" type="sphere" size="0.012" pos="-0.105 0.105 0.018" material="blue_dot"
            contype="0" conaffinity="0"/>
      <geom name="dot_y" type="sphere" size="0.012" pos="-0.105 -0.105 0.018" material="yellow_dot"
            contype="0" conaffinity="0"/>
      <geom name="dot_m" type="sphere" size="0.012" pos="0 0 0.018" material="magenta_dot"
            contype="0" conaffinity="0"/>
    </body>

    <camera name="overview" pos="1.3500 -1.5500 1.0500" xyaxes="0.857493 0.514496 -0.000000 -0.214692 0.357820 0.908775" fovy="46"/>
  </worldbody>
</mujoco>
