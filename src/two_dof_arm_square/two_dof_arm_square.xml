          <body name="ee" pos="0.25 0 0">
            <geom name="ee" type="sphere" size="0.02" rgba="1 0 1 1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <position name="joint1" joint="joint1" kp="20"/>
    <position name="joint2" joint="joint2" kp="20"/>
