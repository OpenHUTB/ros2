<launch>
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <param name="use_sim_time" value="true"/>
  <param name="robot_description" command="$(find xacro)/xacro '$(find urdf_car_slam)/urdf/car.urdf.xacro'"/>
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find urdf_car_slam)/worlds/training.world"/>
    <arg name="gui" value="$(arg gui)"/><arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
  </include>
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_car" args="-urdf -param robot_description -model student_car -x 0 -y 0 -z 0.04" output="screen"/>
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher"/>
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <remap from="scan" to="/scan"/>
    <param name="base_frame" value="base_footprint"/>
    <param name="odom_frame" value="odom"/><param name="map_frame" value="map"/>
    <param name="map_update_interval" value="2.0"/>
    <param name="maxUrange" value="7.5"/><param name="maxRange" value="8.0"/>
    <param name="linearUpdate" value="0.15"/><param name="angularUpdate" value="0.15"/>
    <param name="temporalUpdate" value="1.0"/><param name="particles" value="30"/>
    <param name="delta" value="0.05"/>
    <param name="xmin" value="-6"/><param name="ymin" value="-6"/>
    <param name="xmax" value="6"/><param name="ymax" value="6"/>
  </node>
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find urdf_car_slam)/rviz/slam.rviz"/>
</launch>
