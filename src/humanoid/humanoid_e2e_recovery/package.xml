<?xml version="1.0"?>
<package format="3">
  <name>humanoid_e2e_recovery</name>
  <version>0.2.0</version>
  <description>人形机器人端到端视觉平衡控制（前视图像 → 力矩增量，行为克隆）</description>
  <maintainer email="WZJ6666wudu@users.noreply.github.com">WZJ6666wudu</maintainer>
  <license>MIT</license>

  <!-- ament_python 包无需 buildtool_depend；构建方式由下方 build_type 决定 -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- mujoco 在 rosdep 中没有定义（rosdep resolve mujoco → no rosdep rule），
       因此不写 exec_depend，改由 requirements.txt 通过 pip 安装。
       这里声明 python3-pip，保证 `rosdep install` 会把 pip 装好。 -->
  <exec_depend>python3-pip</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
