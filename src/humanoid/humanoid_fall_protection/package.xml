<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>humanoid_fall_protection</name>
  <version>1.0.0</version>
  <description>人形机器人跌倒预判与保护性倒地：倾角/角速度双判据 + 屈膝蜷身分散落地冲击，基于 MuJoCo</description>
  <maintainer email="L2008-by@users.noreply.github.com">L2008-by</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>

  <!-- 运行依赖：
       numpy 走系统包（rosdep 可解析）；MuJoCo 在 Ubuntu 22.04 没有 apt 包，
       本模块一律用 pip 安装（见 requirements.txt 与 README 的安装步骤），
       因此不写 exec_depend mujoco，避免 rosdep 去找不存在的包。
       注意：XML 注释里不能出现连续两个连字符，所以这里不写完整命令。 -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
