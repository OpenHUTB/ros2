<?xml version="1.0"?>
<sdf version="1.6">
  <world name="humanoid_world">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>
    <model name="red_target">
      <static>true</static><pose>3 0 0.5 0 0 0</pose>
      <link name="link"><visual name="v">
        <geometry><cylinder radius="0.2" length="1.0"/></geometry>
        <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material>
      </visual></link>
    </model>
    <model name="obstacle1">
      <static>true</static><pose>2 1.5 0.5 0 0 0</pose>
      <link name="link"><visual name="v">
        <geometry><box size="0.5 0.5 1.0"/></geometry>
        <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material>
      </visual></link>
    </model>
    <model name="humanoid">
      <static>false</static><pose>0 0 0.5 0 0 0</pose>
      <link name="base_link"><visual name="v">
        <geometry><box size="0.3 0.2 0.6"/></geometry>
        <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
      </visual>
      <collision name="c"><geometry><box size="0.3 0.2 0.6"/></geometry></collision></link>
    </model>
  </world>
</sdf>
