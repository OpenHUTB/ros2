<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>humanoid_h1_walk</name>
  <version>0.1.0</version>
  <description>
    MuJoCo 物理仿真下 Unitree H1 与 H1_2 人形机器人的神经网络行走控制模块。
    策略为 PPO 训练得到的 TorchScript 网络（每 20 ms 推理一次）：输入机身角速度、
    机体系重力方向、速度指令、腿部关节角与角速度、上一帧动作和步态相位（H1 41 维、
    H1_2 47 维），输出 10/12 个关节的目标角，PD 控制器再把它变成力矩。
    ROS 2 接口提供 /joint_states、/odom、/humanoid/obs、/cmd_vel，支持键盘遥控与
    固定动作序列演示。
  </description>

  <maintainer email="maintainer@example.com">OpenHUTB contributor</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- 策略推理依赖 PyTorch（CPU 版即可）。Ubuntu 源没有稳定的对应 deb 包，
       故不写成 rosdep 键，请按 README「安装」一节用 pip 安装 CPU 版。 -->

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
