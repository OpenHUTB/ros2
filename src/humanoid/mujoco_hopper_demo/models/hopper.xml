<mujoco model="hopper">
  <compiler angle="radian" coordinate="local" inertiafromgeom="true"/>
  <option timestep="0.01" gravity="0 0 -9.81"/>
  
  <default>
    <joint armature="1" damping="1" limited="true"/>
    <geom condim="3" friction="1.5 .1 .1" rgba="0.8 0.8 0.8 1"/>
  </default>

  <worldbody>
    <light pos="0 0 5" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" pos="0 0 0" size="3 3 0.1" rgba="0.9 0.9 0.9 1"/>
    
    <body name="torso" pos="0 0 1.5">
      <geom name="torso_geom" type="sphere" size="0.25" mass="5" rgba="0.2 0.6 0.3 1"/>
      
      <body name="thigh" pos="0 0 -0.25">
        <joint name="hip_joint" type="slide" axis="0 0 1" range="0 0.5"/>
        <geom name="thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.3" size="0.08" mass="1" rgba="0.3 0.3 0.8 1"/>
        
        <body name="foot" pos="0 0 -0.3">
          <geom name="foot_geom" type="sphere" size="0.1" mass="0.5" rgba="0.8 0.2 0.2 1"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="hip_motor" joint="hip_joint" gear="100" ctrlrange="-100 100"/>
  </actuator>

  <sensor>
    <jointpos joint="hip_joint" name="hip_pos"/>
    <framepos objtype="body" objname="torso" name="torso_pos"/>
  </sensor>
</mujoco>
