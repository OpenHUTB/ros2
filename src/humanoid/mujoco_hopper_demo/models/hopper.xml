<mujoco model="hopper">
  <compiler angle="radian" coordinate="local" inertiafromgeom="true"/>
  <option timestep="0.01" gravity="0 0 -9.81"/>
  
  <default>
    <joint armature="1" damping="1" limited="true"/>
    <geom friction="1.5 .1 .1" rgba="0.8 0.8 0.8 1"/>
  </default>

  <worldbody>
    <light pos="0 0 5" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" pos="0 0 0" size="3 3 0.1" rgba="0.9 0.9 0.9 1"/>
    
    <!-- 初始位置调低，脚刚好接触地面，不悬空 -->
    <body name="torso" pos="0 0 0.45">
      <geom name="torso_geom" type="sphere" size="0.2" mass="5" rgba="0.2 0.6 0.3 1"/>
      
      <body name="thigh" pos="0 0 -0.2">
        <joint name="hip_joint" type="slide" axis="0 0 1" range="0 0.3"/>
        <geom name="thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.2" size="0.05" mass="1" rgba="0.3 0.3 0.8 1"/>
        
        <body name="foot" pos="0 0 -0.2">
          <geom name="foot_geom" type="sphere" size="0.05" mass="0.5" rgba="0.8 0.2 0.2 1"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="hip_motor" joint="hip_joint" gear="200" ctrlrange="-200 200"/>
  </actuator>

  <sensor>
    <jointpos joint="hip_joint" name="hip_pos"/>
    <framepos objtype="body" objname="torso" name="torso_pos"/>
  </sensor>
</mujoco>
