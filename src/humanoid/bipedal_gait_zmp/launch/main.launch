<?xml version="1.0"?>
<launch>
  <!--
    双足步态生成与 ZMP 稳定性验证的演示。模块只依赖 Python 标准库，
    不订阅也不发布任何话题，这里用 launch 统一入口与输出目录，
    便于和其他模块一样被 roslaunch 拉起。

    用法：
      roslaunch bipedal_gait_zmp main.launch
      roslaunch bipedal_gait_zmp main.launch args:="--quick"
      roslaunch bipedal_gait_zmp main.launch args:="--gain 1.5"
  -->

  <!-- 透传给 main.py 的额外参数 -->
  <arg name="args" default="" />

  <!-- 曲线输出目录，默认放在包内 demo_out/ -->
  <arg name="outdir" default="$(find bipedal_gait_zmp)/demo_out" />

  <node
    pkg="bipedal_gait_zmp"
    type="main.py"
    name="bipedal_gait_zmp"
    output="screen"
    args="$(arg args) --outdir $(arg outdir)"
  />

</launch>
