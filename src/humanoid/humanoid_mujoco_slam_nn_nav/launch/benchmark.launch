<?xml version="1.0"?>
<!-- 三场景一键评测：roslaunch humanoid_mujoco_slam_nn_nav benchmark.launch scene:=corridor policy:=classical -->
<launch>
  <arg name="scene" default="warehouse"/>
  <arg name="policy" default="classical"/>
  <arg name="goal_x" default="2.4"/>
  <arg name="goal_y" default="0.0"/>
  <arg name="timeout" default="150"/>

  <node pkg="humanoid_mujoco_slam_nn_nav" type="sim_node.py" name="humanoid_sim" output="log">
    <param name="scene" value="$(arg scene)"/>
  </node>
  <node pkg="humanoid_mujoco_slam_nn_nav" type="nav_node.py" name="humanoid_nav" output="log">
    <param name="goal_x" value="$(arg goal_x)"/>
    <param name="goal_y" value="$(arg goal_y)"/>
    <param name="policy" value="$(arg policy)"/>
  </node>
  <node pkg="humanoid_mujoco_slam_nn_nav" type="metrics_node.py" name="humanoid_metrics" output="log">
    <param name="mode" value="$(arg policy)"/>
    <param name="scene" value="$(arg scene)"/>
    <param name="goal_x" value="$(arg goal_x)"/>
    <param name="goal_y" value="$(arg goal_y)"/>
    <param name="timeout" value="$(arg timeout)"/>
    <param name="output" value="$(find humanoid_mujoco_slam_nn_nav)/results/ros_$(arg policy)_$(arg scene).json"/>
  </node>
</launch>
