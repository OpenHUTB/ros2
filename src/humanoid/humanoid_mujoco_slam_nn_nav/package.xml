<?xml version="1.0"?>
<package format="2">
  <name>humanoid_mujoco_slam_nn_nav</name>
  <version>1.0.0</version>
  <description>
    MuJoCo 双足人形机器人：物理仿真、键盘遥控、激光 SLAM 建图导航、
    神经网络感知/规划/控制与端到端视觉驾驶（ROS Noetic）。
  </description>
  <maintainer email="student@example.com">Course Project</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf</depend>

  <export>
    <build_type>catkin</build_type>
  </export>
</package>
