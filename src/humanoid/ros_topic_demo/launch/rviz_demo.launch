<launch>
  <!-- 圆半径、一圈时间、发布频率都可以在命令行覆盖，例如：
       roslaunch ros_topic_demo rviz_demo.launch period:=5.0 radius:=1.5 -->
  <arg name="radius" default="1.0"/>
  <arg name="period" default="31.4"/>
  <arg name="rate" default="10.0"/>
  <arg name="frame_id" default="odom"/>
  <arg name="child_frame_id" default="base_link"/>

  <node pkg="ros_topic_demo" type="trajectory_node.py" name="virtual_point" output="screen">
    <param name="radius" value="$(arg radius)"/>
    <param name="period" value="$(arg period)"/>
    <param name="rate" value="$(arg rate)"/>
    <param name="frame_id" value="$(arg frame_id)"/>
    <param name="child_frame_id" value="$(arg child_frame_id)"/>
  </node>

  <node pkg="rviz" type="rviz" name="rviz"
        args="-d $(find ros_topic_demo)/config/rviz.rviz"/>
</launch>
