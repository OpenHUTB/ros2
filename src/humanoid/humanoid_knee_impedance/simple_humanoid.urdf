<?xml version="1.0"?>
<!--
  简化双足人形模型（六关节：左右髋/膝/踝），与
  humanoid_zmp_walking 模块模型一致。本模块把 base_link 固定在台架上，
  髋与踝位置控制锁死，只让膝关节由阻抗律驱动，因此质量分布就是
  膝关节阶跃响应的全部动力学来源：
    膝下连杆 = 小腿 0.3 kg（质心距膝 0.15 m）+ 足 0.2 kg（质心距膝 0.31 m）
    等效转动惯量 J = 0.0296 kg·m²，重力矩系数 mgl = 1.05 N·m
  关节速度上限仅约束位置控制关节（髋/踝），TORQUE_CONTROL 不受其限制。
-->

<robot name="simple_humanoid">
  <link name="base_link">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <geometry><box size="0.2 0.2 0.4"/></geometry>
      <material name="blue"><color rgba="0 0 1 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.2 0.2 0.4"/></geometry>
    </collision>
  </link>

  <joint name="left_hip" type="revolute">
    <parent link="base_link"/>
    <child link="left_thigh"/>
    <origin xyz="0 0.06 -0.2"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.8" upper="0.8" effort="8" velocity="4.0"/>
  </joint>
  <link name="left_thigh">
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 -0.15"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry><cylinder length="0.3" radius="0.05"/></geometry>
    </visual>
    <collision>
      <geometry><cylinder length="0.3" radius="0.05"/></geometry>
    </collision>
  </link>

  <joint name="right_hip" type="revolute">
    <parent link="base_link"/>
    <child link="right_thigh"/>
    <origin xyz="0 -0.06 -0.2"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.8" upper="0.8" effort="8" velocity="4.0"/>
  </joint>
  <link name="right_thigh">
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 -0.15"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry><cylinder length="0.3" radius="0.05"/></geometry>
    </visual>
    <collision>
      <geometry><cylinder length="0.3" radius="0.05"/></geometry>
    </collision>
  </link>

  <joint name="left_knee" type="revolute">
    <parent link="left_thigh"/>
    <child link="left_shin"/>
    <origin xyz="0 0 -0.3"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.4" effort="8" velocity="4.0"/>
  </joint>
  <link name="left_shin">
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 -0.15"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry><cylinder length="0.3" radius="0.04"/></geometry>
    </visual>
    <collision>
      <geometry><cylinder length="0.3" radius="0.04"/></geometry>
    </collision>
  </link>

  <joint name="right_knee" type="revolute">
    <parent link="right_thigh"/>
    <child link="right_shin"/>
    <origin xyz="0 0 -0.3"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.4" effort="8" velocity="4.0"/>
  </joint>
  <link name="right_shin">
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 -0.15"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry><cylinder length="0.3" radius="0.04"/></geometry>
    </visual>
    <collision>
      <geometry><cylinder length="0.3" radius="0.04"/></geometry>
    </collision>
  </link>

  <joint name="left_ankle" type="revolute">
    <parent link="left_shin"/>
    <child link="left_foot"/>
    <origin xyz="0 0 -0.3"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.6" upper="0.6" effort="8" velocity="4.0"/>
  </joint>
  <link name="left_foot">
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 -0.01"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0006" iyz="0"
               izz="0.0006"/>
    </inertial>
    <visual>
      <geometry><box size="0.14 0.12 0.02"/></geometry>
      <material name="gray"><color rgba="0.6 0.6 0.6 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.14 0.12 0.02"/></geometry>
    </collision>
  </link>

  <joint name="right_ankle" type="revolute">
    <parent link="right_shin"/>
    <child link="right_foot"/>
    <origin xyz="0 0 -0.3"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.6" upper="0.6" effort="8" velocity="4.0"/>
  </joint>
  <link name="right_foot">
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 -0.01"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0006" iyz="0"
               izz="0.0006"/>
    </inertial>
    <visual>
      <geometry><box size="0.14 0.12 0.02"/></geometry>
      <material name="gray"><color rgba="0.6 0.6 0.6 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.14 0.12 0.02"/></geometry>
    </collision>
  </link>
</robot>
