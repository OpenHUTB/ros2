<!--
  双臂搬运负载的人形机器人 MJCF 模型（自建）
  ==================================================================
  用途：humanoid_carry_payload_nn 模块的 MuJoCo 物理场景。

  机器人：
    - 自由度 15（不含自由根）：双腿 ×(髋 yaw/roll/pitch + 膝 + 踝 pitch/roll)
      + 双臂 ×(肩 pitch + 肘 pitch) + 颈 yaw，共 15 个可动关节；
    - 驱动：position 伺服（kp/kv 写在 actuator 中），ctrl 为目标关节角；
    - 双臂保持"抱持"姿态，负载箱通过两条 weld 约束刚性夹持在双手之间。

  负载：
    - body "payload" 带 freejoint，质量由脚本在运行时改写（0 / 2 / 4 kg），
      刚度（weld solref）保证双手夹持近似刚性；
    - 质量改写只影响动力学，几何形状不变，因此三个场景共用同一模型文件。

  坐标系：世界系 +x 为机器人正前方，+y 向左，+z 向上。
-->

<mujoco model="humanoid_carry">
  <compiler angle="radian" coordinate="local" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"
          cone="elliptic" jacobian="dense" iterations="40" solver="Newton"/>

  <default>
    <joint damping="2.0" armature="0.01" frictionloss="0.2"/>
    <geom type="capsule" density="800" friction="1.1 0.35 0.05"
          contype="1" conaffinity="1" condim="3"/>
    <position kp="220" kv="18" forcelimited="true" forcerange="-260 260"/>
  </default>

  <visual>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.55 0.55 0.55" specular="0.05 0.05 0.05"/>
    <global offwidth="1280" offheight="960"/>
  </visual>

  <worldbody>
    <light name="sun" dir="-0.35 -0.45 -1" diffuse="0.95 0.92 0.88" ambient="0.5 0.5 0.5"/>
    <light name="fill" pos="2.0 -2.5 2.4" dir="-0.6 0.7 -1" directional="true"
           diffuse="0.35 0.38 0.45" ambient="0.1 0.1 0.1"/>

    <!-- 跑步机皮带：一个可沿 x 平移的大质量 box，速度由指令给定（负向 = 皮带向后跑），
         机器人相当于"原地行走"，等效搬运里程按指令积分（见 docs 的实验台架说明） -->
    <body name="belt" pos="0 0 -0.03">
      <joint name="belt_x" type="slide" axis="1 0 0" range="-6 6" damping="0" armature="0"/>
      <geom name="belt_geom" type="box" size="7 2.2 0.03" mass="800"
            rgba="0.55 0.57 0.60 1" friction="1.2 0.4 0.1" condim="3"/>
    </body>

    <!-- 观察相机：侧前方俯视，便于看到搬运姿态 -->
    <camera name="overview" pos="1.95 2.55 1.55" xyaxes="-0.79 0.61 0 -0.23 -0.30 0.93" fovy="50"/>
    <camera name="side" pos="0.5 2.6 1.15" xyaxes="1 0 0 0 0.27 0.96" fovy="45"/>

    <!-- 场景参照物：搬运路线两侧的标志桩 -->
    <body name="marker1" pos="2.0 0.9 0.45">
      <geom name="m1" type="cylinder" size="0.08 0.45" rgba="0.85 0.30 0.25 1"/>
    </body>
    <body name="marker2" pos="4.0 -0.9 0.45">
      <geom name="m2" type="cylinder" size="0.08 0.45" rgba="0.25 0.45 0.85 1"/>
    </body>
    <body name="table" pos="6.0 0 0.35">
      <geom name="table_top" type="box" size="0.5 0.6 0.05" rgba="0.55 0.45 0.30 1"/>
      <geom name="table_leg" type="box" size="0.06 0.06 0.35" pos="0 0 -0.35" rgba="0.4 0.33 0.22 1"/>
    </body>

    <!-- ==================== 人形机器人 ==================== -->
    <body name="root" pos="0 0 0.83">
      <!--
        减重助行架（gantry）约束：机器人由弹性吊带悬挂在助行架上。
          - root_x / root_z：前后与竖直方向的平移自由度，由弹性吊带约束（stiffness/damping），
            保证机器人不会跑出轨面，同时保留真实的前后动力学；
          - root_pitch：矢状面内的俯仰自由度（弹性吊带提供回复力矩），
            这是平衡控制器要抑制的"倒立摆"方向；
          - root_yaw：助行架转盘允许整机转向（键盘 A/D）；
          - 侧向平移与横滚被导轨锁定，因此不会侧翻。
      -->
      <joint name="root_x" type="slide" axis="1 0 0" range="-2 2"
             damping="240" stiffness="800"/>
      <joint name="root_z" type="slide" axis="0 0 1" range="-0.30 0.30"
             damping="120" stiffness="900"/>
      <joint name="root_pitch" type="hinge" axis="0 1 0" range="-0.55 0.55"
             damping="130" stiffness="1400"/>
      <joint name="root_yaw" type="hinge" axis="0 0 1" range="-3.15 3.15"
             damping="50" stiffness="90"/>

      <!-- 骨盆 -->
      <geom name="pelvis" type="box" size="0.10 0.12 0.07" mass="8"
            rgba="0.90 0.55 0.15 1"/>

      <!-- ===== 左腿 ===== -->
      <body name="hip_l" pos="0 0.10 -0.05">
        <inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
        <joint name="hip_yaw_l" axis="0 0 1" range="-0.8 0.8"/>
        <body name="hip_roll_l" pos="0 0 0">
          <inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
          <joint name="hip_roll_l" axis="1 0 0" range="-0.6 0.6"/>
          <body name="hip_pitch_l" pos="0 0 0">
            <inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
            <joint name="hip_pitch_l" axis="0 1 0" range="-1.6 1.6"/>
            <body name="thigh_l" pos="0 0 0">
              <geom name="thigh_geom_l" fromto="0 0 0 0 0 -0.36" size="0.055" mass="3.0"
                    rgba="0.90 0.55 0.15 1"/>
              <body name="knee_l" pos="0 0 -0.36">
                <inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
                <joint name="knee_l" axis="0 1 0" range="-2.4 0.05"/>
                <body name="shin_l" pos="0 0 0">
                  <geom name="shin_geom_l" fromto="0 0 0 0 0 -0.36" size="0.045" mass="2.0"
                        rgba="0.90 0.55 0.15 1"/>
                  <body name="ankle_l" pos="0 0 -0.36">
                    <inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
                    <joint name="ankle_pitch_l" axis="0 1 0" range="-0.9 0.9"/>
                    <body name="foot_l" pos="0.03 0 -0.03">
                      <joint name="ankle_roll_l" axis="1 0 0" range="-0.6 0.6"/>
                      <geom name="foot_geom_l" type="box" size="0.135 0.055 0.02" mass="0.9"
                            rgba="0.30 0.32 0.36 1" friction="1.4 0.5 0.1"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- ===== 右腿（与左腿对称，y 取负） ===== -->
      <body name="hip_r" pos="0 -0.10 -0.05">
        <inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
        <joint name="hip_yaw_r" axis="0 0 1" range="-0.8 0.8"/>
        <body name="hip_roll_r" pos="0 0 0">
          <inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
          <joint name="hip_roll_r" axis="1 0 0" range="-0.6 0.6"/>
          <body name="hip_pitch_r" pos="0 0 0">
            <inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
            <joint name="hip_pitch_r" axis="0 1 0" range="-1.6 1.6"/>
            <body name="thigh_r" pos="0 0 0">
              <geom name="thigh_geom_r" fromto="0 0 0 0 0 -0.36" size="0.055" mass="3.0"
                    rgba="0.90 0.55 0.15 1"/>
              <body name="knee_r" pos="0 0 -0.36">
                <inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
                <joint name="knee_r" axis="0 1 0" range="-2.4 0.05"/>
                <body name="shin_r" pos="0 0 0">
                  <geom name="shin_geom_r" fromto="0 0 0 0 0 -0.36" size="0.045" mass="2.0"
                        rgba="0.90 0.55 0.15 1"/>
                  <body name="ankle_r" pos="0 0 -0.36">
                    <inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
                    <joint name="ankle_pitch_r" axis="0 1 0" range="-0.9 0.9"/>
                    <body name="foot_r" pos="0.03 0 -0.03">
                      <joint name="ankle_roll_r" axis="1 0 0" range="-0.6 0.6"/>
                      <geom name="foot_geom_r" type="box" size="0.135 0.055 0.02" mass="0.9"
                            rgba="0.30 0.32 0.36 1" friction="1.4 0.5 0.1"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- ===== 躯干 ===== -->
      <body name="torso" pos="0 0 0.06">
        <geom name="torso_geom" type="box" size="0.10 0.08 0.19" pos="0 0 0.20" mass="12"
              rgba="0.90 0.55 0.15 1"/>

        <!-- 左臂（抱持姿态由控制器给出） -->
        <body name="arm_l" pos="0.06 0.13 0.36">
          <inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
          <joint name="shoulder_pitch_l" axis="0 1 0" range="-2.2 1.2"/>
          <body name="upper_l" pos="0 0 0">
            <geom name="upper_geom_l" fromto="0 0 0 0 0 -0.26" size="0.035" mass="1.2"
                  rgba="0.90 0.62 0.20 1"/>
            <body name="elbow_l" pos="0 0 -0.26">
              <inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
              <joint name="elbow_l" axis="0 1 0" range="-2.0 0.2"/>
              <body name="fore_l" pos="0 0 0">
                <geom name="fore_geom_l" fromto="0 0 0 0 0 -0.24" size="0.03" mass="0.8"
                      rgba="0.90 0.62 0.20 1"/>
              </body>
            </body>
          </body>
        </body>

        <!-- 右臂 -->
        <body name="arm_r" pos="0.06 -0.13 0.36">
          <inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
          <joint name="shoulder_pitch_r" axis="0 1 0" range="-2.2 1.2"/>
          <body name="upper_r" pos="0 0 0">
            <geom name="upper_geom_r" fromto="0 0 0 0 0 -0.26" size="0.035" mass="1.2"
                  rgba="0.90 0.62 0.20 1"/>
            <body name="elbow_r" pos="0 0 -0.26">
              <inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
              <joint name="elbow_r" axis="0 1 0" range="-2.0 0.2"/>
              <body name="fore_r" pos="0 0 0">
                <geom name="fore_geom_r" fromto="0 0 0 0 0 -0.24" size="0.03" mass="0.8"
                      rgba="0.90 0.62 0.20 1"/>
              </body>
            </body>
          </body>
        </body>

        <!-- 颈 + 头 -->
        <body name="neck" pos="0 0 0.42">
          <inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
          <joint name="neck_yaw" axis="0 0 1" range="-0.5 0.5"/>
          <body name="head" pos="0 0 0.05">
            <geom name="head_geom" type="sphere" size="0.085" mass="1.0" rgba="0.32 0.34 0.38 1"/>
            <camera name="head_camera" pos="0.02 0 0.04" xyaxes="1 0 0 0 1 0" fovy="60"/>
          </body>
        </body>
      </body>
    </body>

    <!-- 负载箱：独立 body（freejoint 只能位于顶层的世界系），由两条 weld 与双手前臂夹持 -->
    <body name="payload" pos="0.34 0 1.00">
      <freejoint name="payload_free"/>
      <geom name="payload_geom" type="box" size="0.10 0.09 0.09" mass="2"
            rgba="0.25 0.55 0.35 1" friction="1.0 0.3 0.1"/>
    </body>
  </worldbody>

  <!-- 双手夹持：两条 weld 把负载箱与左右前臂刚性连接 -->
  <equality>
    <weld name="grip_l" body1="fore_l" body2="payload" relpose="-0.0325 -0.1300 -0.1432 0.6967 0.0000 0.7174 0.0000"
          solref="0.004 1" solimp="0.9 0.95 0.005"/>
    <weld name="grip_r" body1="fore_r" body2="payload" relpose="-0.0325 0.1300 -0.1432 0.6967 0.0000 0.7174 0.0000"
          solref="0.004 1" solimp="0.9 0.95 0.005"/>
  </equality>

  <actuator>
    <position name="hip_yaw_l" joint="hip_yaw_l"/>
    <position name="hip_roll_l" joint="hip_roll_l"/>
    <position name="hip_pitch_l" joint="hip_pitch_l"/>
    <position name="knee_l" joint="knee_l"/>
    <position name="ankle_pitch_l" joint="ankle_pitch_l"/>
    <position name="ankle_roll_l" joint="ankle_roll_l"/>
    <position name="hip_yaw_r" joint="hip_yaw_r"/>
    <position name="hip_roll_r" joint="hip_roll_r"/>
    <position name="hip_pitch_r" joint="hip_pitch_r"/>
    <position name="knee_r" joint="knee_r"/>
    <position name="ankle_pitch_r" joint="ankle_pitch_r"/>
    <position name="ankle_roll_r" joint="ankle_roll_r"/>
    <position name="shoulder_pitch_l" joint="shoulder_pitch_l" kp="400" kv="30"
              forcerange="-200 200"/>
    <position name="elbow_l" joint="elbow_l" kp="400" kv="30" forcerange="-200 200"/>
    <position name="shoulder_pitch_r" joint="shoulder_pitch_r" kp="400" kv="30"
              forcerange="-200 200"/>
    <position name="elbow_r" joint="elbow_r" kp="400" kv="30" forcerange="-200 200"/>
    <position name="neck_yaw" joint="neck_yaw" kp="80" kv="8" forcerange="-40 40"/>
  </actuator>
</mujoco>
