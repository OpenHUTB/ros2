<launch>
  <arg name="sim_python"/>
  <arg name="sim_entry"/>
  <arg name="weights" default="$(find g1_costnet_grid_planner)/models"/>
  <arg name="output" default="results"/>
    <node pkg="g1_costnet_grid_planner" type="task_runner.py" name="humanoid_task_runner" output="screen" required="true">
      <param name="sim_python" value="$(arg sim_python)"/><param name="sim_entry" value="$(arg sim_entry)"/>
      <param name="weights" value="$(arg weights)"/><param name="output" value="$(arg output)"/>
    </node>
</launch>
