<?xml version="1.0"?>
<robot name="car" xmlns:xacro="shturl.cc/L5WbLQHT1e7kJCt">

  <xacro:macro name="wheel" params="name x y z">
    <link name="${name}">
      <visual>
        <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.1" length="0.05"/>
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.1" length="0.05"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="${x} ${y} ${z}"/>
        <mass value="0.2"/>
        <inertia ixx="0.0001" iyy="0.0001" izz="0.0001"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 1.5708 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.6 0.3 0.2"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.6 0.3 0.2"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.15"/>
      <mass value="2.0"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01"/>
    </inertial>
  </link>

  <xacro:wheel name="wheel_fl" x="0.2" y="0.15" z="0"/>
  <xacro:wheel name="wheel_fr" x="0.2" y="-0.15" z="0"/>
  <xacro:wheel name="wheel_rl" x="-0.2" y="0.15" z="0"/>
  <xacro:wheel name="wheel_rr" x="-0.2" y="-0.15" z="0"/>

</robot>