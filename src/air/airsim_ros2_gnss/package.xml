<?xml version="1.0"?>
<package format="3">
  <name>airsim_ros2_gnss</name>
  <version>0.1.0</version>
  <description>ROS 2 Humble AirSim GNSS bridge publishing sensor_msgs/NavSatFix.</description>
  <maintainer email="dmjtr@users.noreply.github.com">dmjtr</maintainer>
  <license>MIT</license>

  <buildtool_depend>python3-setuptools</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
