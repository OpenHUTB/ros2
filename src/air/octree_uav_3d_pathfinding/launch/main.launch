<?xml version="1.0"?>
<launch>
  <!-- ============================================================
       空域载具八叉树三维寻路 —— 模块统一入口

       用法：
         roslaunch octree_uav_3d_pathfinding main.launch
         roslaunch octree_uav_3d_pathfinding main.launch rviz:=false
         roslaunch octree_uav_3d_pathfinding main.launch mapping:=false
         roslaunch octree_uav_3d_pathfinding main.launch planning:=false

       前置条件：
         宿主 Windows 上已经启动 OpenHUTB 模拟器（AirSim 多旋翼模式，RPC 41451）。
         它不在本 launch 里启动 —— 模拟器是 Windows 程序，跑在宿主上，不在虚拟机里。

       运行内容：
         1) airsim_bridge          从 AirSim 取回点云与位姿，发 /cloud_in 与 TF
         2) pointcloud_to_octomap  点云 → 八叉树占用地图 + RViz 可视化
         3) astar_planner          八叉树上的 A* 全局寻路，发 /uav/path
         4) uav_env_check          环境与链路自检（跑完自动退出）
         5) rviz                   显示点云、占用体素与规划路径
       ============================================================ -->

  <!-- 是否启动 AirSim 桥接节点 -->
  <arg name="bridge" default="true"/>

  <!-- 是否启动点云建图节点 -->
  <arg name="mapping" default="true"/>

  <!-- 是否运行环境与链路自检节点 -->
  <arg name="check" default="true"/>

  <!-- 是否启动 RViz -->
  <arg name="rviz" default="true"/>

  <!-- 是否启动 A* 规划节点 -->
  <arg name="planning" default="true"/>

  <!-- P5：路径平滑的默认开关。
       与 config/params.yaml 里的 smoothing 是同一个参数，这里暴露成 launch 参数
       只是为了方便在命令行临时开关，不用改配置文件：
         roslaunch ... main.launch                    # 用 yaml 里的值（默认 false）
         roslaunch ... main.launch smoothing:=true    # 临时打开平滑做对比 -->
  <arg name="smoothing" default="false"/>

  <!-- P5：安全裕度半径（m）。同样是为了命令行临时开关：
         roslaunch ... main.launch inflation_radius:=0.6
       0 表示关闭膨胀（此时行为逐位等于上一阶段，可做回归对照）。
       与 smoothing 一样，只在节点启动时读取，改动后要重启节点。 -->
  <arg name="inflation_radius" default="0.0"/>

  <!-- 规划节点取起点用的机体坐标系。
       正常跑仿真时是 base_link（由 airsim_bridge 广播）；
       用 mock_cloud_publisher.py 做离线验证时，它只广播 world -> lidar_link，
       所以那时要传 body_frame:=lidar_link -->
  <arg name="body_frame" default="base_link"/>

  <!-- 桥接节点接收"要飞到哪里"的话题。
       默认 /uav/goal 与 P1'–P5 完全一致（用户发一个目标点，规划器规划、载具飞过去）。
       P6 的闭环飞行由 full_demo.launch 把它设成 /uav/goal_cmd —— 那里由 path_follower
       逐点下发航点，如果仍用 /uav/goal，astar_planner 会把每个航点当成新目标重新规划。 -->
  <arg name="bridge_goal_topic" default="/uav/goal"/>

  <!-- 载入参数配置 -->
  <rosparam command="load"
            file="$(find octree_uav_3d_pathfinding)/config/params.yaml"/>

  <!-- AirSim 桥接节点：订阅目标点，发布 /cloud_in、/ground_truth/odom 与 TF -->
  <node if="$(arg bridge)"
        pkg="octree_uav_3d_pathfinding"
        type="airsim_bridge.py"
        name="airsim_bridge"
        output="screen">
    <param name="goal_topic" value="$(arg bridge_goal_topic)"/>
  </node>

  <!-- 点云建图节点：/cloud_in → /octomap_full 与 /occupied_cells_vis_array -->
  <node if="$(arg mapping)"
        pkg="octree_uav_3d_pathfinding"
        type="pointcloud_to_octomap"
        name="pointcloud_to_octomap"
        output="screen"/>

  <!-- A* 规划节点：/octomap_full + /uav/goal → /uav/path
       只做规划、不控制飞行；把路径喂给控制器是后续阶段的事 -->
  <node if="$(arg planning)"
        pkg="octree_uav_3d_pathfinding"
        type="astar_planner"
        name="astar_planner"
        output="screen">
    <param name="body_frame" value="$(arg body_frame)"/>
    <param name="smoothing" value="$(arg smoothing)"/>
    <param name="inflation_radius" value="$(arg inflation_radius)"/>
  </node>

  <!-- 环境与链路自检节点
       依次检查 AirSim RPC、点云链路、TF 与话题通信，跑完自动退出，不影响仿真 -->
  <node if="$(arg check)"
        pkg="octree_uav_3d_pathfinding"
        type="main.py"
        name="uav_env_check"
        output="screen"
        required="false"/>

  <!-- RViz：显示点云、八叉树地图与规划路径 -->
  <node if="$(arg rviz)"
        pkg="rviz"
        type="rviz"
        name="rviz"
        output="screen"
        args="-d $(find octree_uav_3d_pathfinding)/rviz/default.rviz"/>

</launch>
