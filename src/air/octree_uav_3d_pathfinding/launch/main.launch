<?xml version="1.0"?>
<launch>
  <!-- 空域载具八叉树三维寻路 —— 模块统一入口
       用法：
         roslaunch octree_uav_3d_pathfinding main.launch
         roslaunch octree_uav_3d_pathfinding main.launch gui:=true
         roslaunch octree_uav_3d_pathfinding main.launch duration:=20
  -->

  <arg name="gui" default="false"/>
  <arg name="rviz" default="false"/>
  <arg name="duration" default="10"/>

  <rosparam command="load"
            file="$(find octree_uav_3d_pathfinding)/config/params.yaml"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="debug" value="false"/>
  </include>

  <node pkg="octree_uav_3d_pathfinding"
        type="main.py"
        name="uav_env_check"
        output="screen"
        required="true">
    <param name="check_duration" value="$(arg duration)"/>
  </node>

  <node if="$(arg rviz)"
        pkg="rviz"
        type="rviz"
        name="rviz"
        output="screen"
        args="-d $(find octree_uav_3d_pathfinding)/rviz/default.rviz"/>

</launch>
