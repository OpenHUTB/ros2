<!--
  X 型四旋翼。世界系 ENU（x 东 y 北 z 上），机体系 FLU（x 前 y 左 z 上），
  与 carlair_ros_bridge 一致，无需坐标换算。

  旋翼布置（俯视，前为 +x），对角同向、相邻反向：
        前(+x)
    4(CW)   3(CW)
        \  /
        /  \
    2(CCW)  1(CCW)
        后(-x)
  本模型：旋翼 1(前右)/2(后左) CCW，3(前左)/4(后右) CW。

  混控（桨臂 a = L/(2√2)；T 沿机体 +z；τx/τy/τz = 滚转/俯仰/偏航，
  k_m 为反扭矩系数）：
    T  = T1 + T2 + T3 + T4
    τx = a(-T1 + T2 + T3 - T4)
    τy = a(-T1 + T2 - T3 + T4)
    τz = k_m(-T1 - T2 + T3 + T4)
  逆解（u = τx/a, v = τy/a, w = τz/k_m）：
    T1 = (T - u - v - w)/4     T2 = (T + u + v - w)/4
    T3 = (T + u + w - v)/4     T4 = (T + v + w - u)/4
-->
<mujoco model="quadrotor">
  <compiler angle="radian" coordinate="local" autolimits="true"/>

  <!-- 时间步长：控制 100 Hz（0.01 s），物理子步 4 次（0.0025 s） -->
  <option timestep="0.0025" integrator="RK4" gravity="0 0 -9.81"/>

  <!-- 头灯跟随相机：固定光源在 urban_block 等 70 m 级场景覆盖不全 -->
  <visual>
    <headlight ambient="0.38 0.38 0.40" diffuse="0.55 0.55 0.56"
               specular="0.15 0.15 0.15"/>
    <map znear="0.02" zfar="120"/>
    <quality shadowsize="2048"/>
  </visual>

  <default>
    <default class="drone">
      <geom rgba="0.15 0.15 0.18 1" contype="0" conaffinity="0"/>
      <site rgba="0 0 0 0" size="0.005"/>
    </default>
    <default class="rotor">
      <geom type="cylinder" size="0.064 0.006" rgba="0.1 0.1 0.12 1"
            contype="0" conaffinity="0"/>
    </default>
    <default class="prop">
      <geom type="box" size="0.062 0.009 0.0015" rgba="0.75 0.78 0.82 0.55"
            contype="0" conaffinity="0"/>
    </default>
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="256" height="256"
             rgb1="0.42 0.46 0.42" rgb2="0.34 0.38 0.34"/>
    <material name="grid" texture="grid" texrepeat="6 6" reflectance="0.05"/>
    <material name="body_mat" rgba="0.16 0.17 0.20 1" specular="0.5" shininess="0.4"/>
    <material name="arm_mat"  rgba="0.08 0.08 0.10 1"/>
  </asset>

  <worldbody>
    <!--
      方向光（directional="true"）：点光源随距离衰减，70 m 级场景中离光源 30 m 处
      近乎全黑（实测）；方向光按方向均匀照亮，5 个场景共用一套光照。
    -->
    <light name="sun" pos="0 0 20" dir="-0.3 0.2 -1" directional="true"
           diffuse="0.62 0.62 0.60" specular="0.25 0.25 0.25" castshadow="true"/>
    <light name="fill" pos="0 0 6" dir="0 0 -1"
           diffuse="0.30 0.30 0.32" castshadow="false"/>
    <light name="rim" pos="3 3 4" dir="-0.5 -0.5 -1"
           diffuse="0.20 0.20 0.22" castshadow="false"/>

    <body name="base_link" pos="0 0 1.5">
      <freejoint name="root"/>
      <inertial pos="0 0 0" mass="0.85"
                diaginertia="0.0042 0.0042 0.0078"/>

      <geom name="body_geom" class="drone" type="box" size="0.055 0.055 0.028"
            material="body_mat"/>
      <geom name="arm_fr" class="drone" type="capsule" fromto="0 0 0  0.106 -0.106 0" size="0.007" material="arm_mat"/>
      <geom name="arm_fl" class="drone" type="capsule" fromto="0 0 0  0.106  0.106 0" size="0.007" material="arm_mat"/>
      <geom name="arm_rl" class="drone" type="capsule" fromto="0 0 0 -0.106  0.106 0" size="0.007" material="arm_mat"/>
      <geom name="arm_rr" class="drone" type="capsule" fromto="0 0 0 -0.106 -0.106 0" size="0.007" material="arm_mat"/>

      <!-- ==== 旋翼 1：前右（CCW） ==== -->
      <body name="rotor1" pos="0.106 -0.106 0.012">
        <inertial pos="0 0 0" mass="0.025" diaginertia="3e-5 3e-5 3e-5"/>
        <geom class="rotor" name="rotor1_hub"/>
        <geom class="prop"  name="rotor1_b1"/>
        <geom class="prop"  name="rotor1_b2" quat="0 0 0.7071 0.7071"/>
        <site name="thrust1" class="drone" pos="0 0 0"/>
      </body>
      <!-- ==== 旋翼 2：后左（CCW） ==== -->
      <body name="rotor2" pos="-0.106 0.106 0.012">
        <inertial pos="0 0 0" mass="0.025" diaginertia="3e-5 3e-5 3e-5"/>
        <geom class="rotor" name="rotor2_hub"/>
        <geom class="prop"  name="rotor2_b1"/>
        <geom class="prop"  name="rotor2_b2" quat="0 0 0.7071 0.7071"/>
        <site name="thrust2" class="drone" pos="0 0 0"/>
      </body>
      <!-- ==== 旋翼 3：前左（CW） ==== -->
      <body name="rotor3" pos="0.106 0.106 0.012">
        <inertial pos="0 0 0" mass="0.025" diaginertia="3e-5 3e-5 3e-5"/>
        <geom class="rotor" name="rotor3_hub"/>
        <geom class="prop"  name="rotor3_b1"/>
        <geom class="prop"  name="rotor3_b2" quat="0 0 0.7071 0.7071"/>
        <site name="thrust3" class="drone" pos="0 0 0"/>
      </body>
      <!-- ==== 旋翼 4：后右（CW） ==== -->
      <body name="rotor4" pos="-0.106 -0.106 0.012">
        <inertial pos="0 0 0" mass="0.025" diaginertia="3e-5 3e-5 3e-5"/>
        <geom class="rotor" name="rotor4_hub"/>
        <geom class="prop"  name="rotor4_b1"/>
        <geom class="prop"  name="rotor4_b2" quat="0 0 0.7071 0.7071"/>
        <site name="thrust4" class="drone" pos="0 0 0"/>
      </body>

      <!-- ==== 传感器 ==== -->
      <!-- 前视相机，朝机体 +x；输出 /camera/image_raw、/depth、/seg -->
      <camera name="front_cam" pos="0.075 0 0.012"
              xyaxes="0 -1 0  0 0 1" fovy="70"/>
      <!-- 下视相机（供视觉/地形任务选用） -->
      <camera name="down_cam" pos="0 0 -0.03"
              xyaxes="1 0 0  0 1 0" fovy="80"/>
      <site name="imu" class="drone" pos="0 0 0"/>
      <!-- 雷达安装点（抬高原点，避开自身机体） -->
      <site name="lidar" class="drone" pos="0 0 0.05"/>
    </body>
  </worldbody>

  <!--
    执行器：site 传动，ctrl = 旋翼推力（N），沿机体 +z；gear="0 0 1 0 0 0" 仅产生 z 向力、无力矩。
    偏航反扭矩由 Python 侧按 k_m 施加（core/quadrotor.py）。ctrlrange 上限 6 N = 单桨最大推力（整机推重比约 2.9）。
  -->
  <actuator>
    <general name="thrust1" site="thrust1" gear="0 0 1 0 0 0" ctrlrange="0 6" ctrllimited="true"/>
    <general name="thrust2" site="thrust2" gear="0 0 1 0 0 0" ctrlrange="0 6" ctrllimited="true"/>
    <general name="thrust3" site="thrust3" gear="0 0 1 0 0 0" ctrlrange="0 6" ctrllimited="true"/>
    <general name="thrust4" site="thrust4" gear="0 0 1 0 0 0" ctrlrange="0 6" ctrllimited="true"/>
  </actuator>

  <sensor>
    <!-- IMU：姿态四元数 + 角速度 + 线加速度（机体局部系） -->
    <framequat   name="imu_quat" objtype="body" objname="base_link"/>
    <gyro        name="imu_gyro" site="imu"/>
    <accelerometer name="imu_acc" site="imu"/>
    <!-- 真值里程计（供评估与离线复现；机体系线速度 + 世界系位置） -->
    <velocimeter name="imu_vel" site="imu"/>
    <framepos    name="gt_pos" objtype="body" objname="base_link"/>
    <framelinvel name="gt_linvel" objtype="body" objname="base_link"/>
  </sensor>
</mujoco>
