<?xml version="1.0"?>
<package format="2">
  <name>uav_route_cruise</name>
  <version>0.1.0</version>
  <description>
    基于 PPO 的无人机固定路线巡航模块。

    与 uav_ppo_nav（随机目标点导航）互补：这里给一条**固定闭合航线**，
    无人机沿航线巡航一整圈；障碍物随机摆放，其中一部分直接压在航线上，
    必须临时偏离航线绕行再回到线上。观测由激光雷达扇形直方图 + 航线几何
    （横向偏差、航向偏差、前方航点）拼接而成，动作是世界系 ENU 速度。
    训练在轻量质点环境完成，部署在 CarlaAir/AirSim 仿真器。
  </description>
  <maintainer email="uav@example.com">uav</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>rospy</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>std_msgs</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>rospkg</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export/>
</package>
