<launch>
  <!-- ============================================================
       uav_keyboard_control 统一启动入口（任务①键盘控制）
         roslaunch uav_keyboard_control main.launch
         前置条件：先另开终端启动 carlair_ros_bridge（负责连仿真、执行指令）

       速度参数全部来自 config/keyboard.yaml：
         forward_speed 2.0 / side_speed 0.5 / vert_speed 1.0 / yaw_rate 0.4
       直接在当前终端前台运行 main.py，RawKeyReader 会打开 /dev/tty 读键。
       ============================================================ -->
  <arg name="cmd_vel_topic" default="/uav/cmd_vel" doc="速度指令话题，与桥接包保持一致"/>

  <rosparam command="load" file="$(find uav_keyboard_control)/config/keyboard.yaml"/>
  <param name="topic/cmd_vel" value="$(arg cmd_vel_topic)"/>

  <node pkg="uav_keyboard_control" type="main.py"
        name="uav_keyboard_control" output="screen"/>
</launch>
