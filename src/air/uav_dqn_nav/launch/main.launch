<launch>
  <!-- ============================================================
       uav_dqn_nav 统一启动入口（DQN 自主导航避障）
         roslaunch uav_dqn_nav main.launch

       ⚠️ 前置条件（缺一不可）：
         1) 先启动桥接，而且【必须】加 body_frame:=false ——
            因为本节点输出的是【世界系 ENU】速度，桥接默认按机体系解释会导致乱飞：
              roslaunch carlair_ros_bridge main.launch publish_image:=false body_frame:=false
         2) 目标点 goal_x/goal_y/goal_z 是【绝对 ENU 坐标】，要写无人机当前位置附近可达的点。
       ============================================================ -->

  <arg name="goal_x" default="4.0"  doc="目标点 ENU x (米，绝对坐标)"/>
  <arg name="goal_y" default="3.0"  doc="目标点 ENU y (米，绝对坐标)"/>
  <arg name="goal_z" default="-27.0" doc="目标点 ENU z (米，绝对坐标)"/>

  <rosparam command="load" file="$(find uav_dqn_nav)/config/dqn_nav.yaml"/>
  <param name="nav/weights" value="$(find uav_dqn_nav)/models/policy_weights.npz"/>
  <param name="nav/goal" value="[$(arg goal_x), $(arg goal_y), $(arg goal_z)]"/>

  <!-- DQN 导航节点（入口 main.py）。
       通过环境变量告知入口脚本「真实源码目录」，绕开 catkin wrapper 无法被
       import 的问题（否则 `import dqn_nav_node` 拿到 wrapper，没有 main）。 -->
  <node pkg="uav_dqn_nav" type="main.py" name="uav_dqn_nav" output="screen">
    <env name="UAV_DQN_SCRIPT_DIR" value="$(find uav_dqn_nav)/scripts"/>
  </node>
</launch>
