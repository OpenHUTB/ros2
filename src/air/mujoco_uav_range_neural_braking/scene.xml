<mujoco model="indoor_uav_braking">
  <option timestep="0.01" gravity="0 0 -9.81"/>
  <visual><global offwidth="800" offheight="500"/><headlight ambient="0.5 0.5 0.5"/></visual>
  <worldbody>
    <light pos="-3 -2 6" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="12 4 0.1" rgba="0.85 0.87 0.9 1"/>
    <geom name="obstacle" type="box" pos="0 0 1.5" size="0.25 1 1.5" rgba="0.85 0.25 0.2 1"/>
    <geom name="back_wall" type="box" pos="-5 2 1.5" size="7 0.1 1.5" rgba="0.7 0.75 0.8 1"/>
    <!-- 固定朝向的纵向运动模型。 Fixed-heading longitudinal motion model. -->
    <body name="drone" pos="-7 0 1.2">
      <joint name="forward" type="slide" axis="1 0 0" damping="0.05"/>
      <joint name="vertical" type="slide" axis="0 0 1" damping="0.05"/>
      <geom name="airframe" type="box" size="0.25 0.18 0.08" mass="0.5" rgba="0.15 0.55 0.85 1"/>
      <geom type="capsule" fromto="-0.3 -0.3 0 0.3 0.3 0" size="0.025" mass="0.01" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="-0.3 0.3 0 0.3 -0.3 0" size="0.025" mass="0.01" contype="0" conaffinity="0"/>
      <site name="front_sensor" pos="0.26 0 0" quat="0.70710678 0 0.70710678 0" size="0.015" rgba="0 1 0 1"/>
    </body>
  </worldbody>
  <sensor>
    <rangefinder name="front_range" site="front_sensor" cutoff="20"/>
    <framepos name="body_position" objtype="body" objname="drone"/>
  </sensor>
</mujoco>
