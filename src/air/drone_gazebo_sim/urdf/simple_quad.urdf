<?xml version="1.0"?>
<robot name="simple_quad">

  <link name="base_link">
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <geometry><box size="0.2 0.2 0.05"/></geometry>
      <material name="blue"><color rgba="0.2 0.4 1 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.2 0.2 0.05"/></geometry>
    </collision>
  </link>

  <!-- 摄像头朝前 -->
  <link name="camera_link">
    <visual><geometry><box size="0.03 0.03 0.03"/></geometry>
      <material name="black"><color rgba="0 0 0 1"/></material></visual>
    <sensor type="camera" name="camera_sensor">
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image><width="320</width><height="240"/><format>R8G8B8</format></image>
        <clip><near>0.1</near><far>50</far></clip>
      </camera>
      <plugin name="camera_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/drone/camera</namespace>
        </ros>
        <frame_name>camera_link</frame_name>
      </plugin>
    </sensor>
  </link>
  <joint name="j_camera" type="fixed"><parent link="base_link"/><child link="camera_link"/>
    <origin xyz="0.1 0 0" rpy="0 0 0"/></joint>

</robot>
