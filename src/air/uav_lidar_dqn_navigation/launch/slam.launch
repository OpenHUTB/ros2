<launch>
  <!-- 任务 3：hector_slam 建图 + DQN 导航同步仿真 -->
  <arg name="airsim_ip" default="172.25.176.1"/>
  <arg name="vehicle_name" default="Drone_1"/>
  <arg name="altitude" default="4.0"/>
  <arg name="goal_x" default="20.0"/>
  <arg name="goal_y" default="0.0"/>

  <!-- 桥接节点：发布 odom 话题与 odom->base_link TF -->
  <node name="drone_bridge" pkg="uav_lidar_dqn_navigation" type="drone_bridge.py" output="screen">
    <param name="airsim_ip" value="$(arg airsim_ip)"/>
    <param name="vehicle_name" value="$(arg vehicle_name)"/>
    <param name="auto_takeoff" value="true"/>
    <param name="takeoff_height" value="$(arg altitude)"/>
    <param name="publish_tf" value="true"/>
  </node>

  <!-- 雷达扫描：累积 1 秒点云拼成 180° LaserScan -->
  <node name="lidar_scan" pkg="uav_lidar_dqn_navigation" type="lidar_scan_node.py" output="screen">
    <param name="airsim_ip" value="$(arg airsim_ip)"/>
    <param name="vehicle_name" value="$(arg vehicle_name)"/>
    <param name="scan_bins" value="180"/>
    <param name="scan_frame" value="laser"/>
    <!-- 180° 雷达扫描，10 Hz；hector 匹配需要足够宽的视场 -->
    <param name="scan_source" value="lidar"/>
    <param name="rate" value="10.0"/>
    <param name="accumulate_sec" value="1.0"/>
  </node>

  <!-- 雷达安装在机体中心下方 0.5 m -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="base_to_laser"
        args="0 0 -0.5 0 0 0 base_link laser"/>

  <!-- gmapping：180° 稀疏雷达下粒子滤波比 hector 的扫描匹配稳定
       （hector 在本场景实测会跟丢、地图呈扇形，见模块文档的实验对比） -->
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <param name="base_frame" value="base_link"/>
    <param name="odom_frame" value="odom"/>
    <param name="map_frame" value="map"/>
    <param name="delta" value="0.05"/>
    <param name="xmin" value="-50.0"/>
    <param name="ymin" value="-50.0"/>
    <param name="xmax" value="50.0"/>
    <param name="ymax" value="50.0"/>
    <param name="maxUrange" value="39.0"/>
    <param name="maxRange" value="40.0"/>
    <param name="particles" value="50"/>
    <param name="linearUpdate" value="0.2"/>
    <param name="angularUpdate" value="0.1"/>
    <param name="temporalUpdate" value="1.0"/>
    <param name="minimumScore" value="50"/>
    <remap from="scan" to="/drone/lidar/scan"/>
  </node>

  <!-- 建图同时跑 DQN 导航策略 -->
  <node name="dqn_nav" pkg="uav_lidar_dqn_navigation" type="dqn_nav_node.py" output="screen">
    <param name="goal_x" value="$(arg goal_x)"/>
    <param name="goal_y" value="$(arg goal_y)"/>
    <param name="goal_z" value="-$(arg altitude)"/>
    <param name="verbose" value="true"/>
    <!-- 建图时降低 DQN 速度，保证粒子滤波有足够重叠的扫描 -->
    <param name="speed_scale" value="0.5"/>
  </node>

  <node name="goal_publisher" pkg="rostopic" type="rostopic"
        args="pub -r 1 /drone/goal geometry_msgs/PointStamped
              '{header: {frame_id: map}, point: {x: $(arg goal_x), y: $(arg goal_y), z: -$(arg altitude)}}'"
        output="log"/>
</launch>
