<launch>
  <!-- 统一启动入口：
       roslaunch uav_lidar_dqn_navigation main.launch mode:=teleop|scan|dqn|slam|e2e -->
  <arg name="mode" default="teleop"/>
  <arg name="airsim_ip" default="172.25.176.1"/>
  <arg name="vehicle_name" default="Drone_1"/>

  <include if="$(eval mode == 'teleop')"
           file="$(find uav_lidar_dqn_navigation)/launch/teleop.launch">
    <arg name="airsim_ip" value="$(arg airsim_ip)"/>
    <arg name="vehicle_name" value="$(arg vehicle_name)"/>
  </include>

  <include if="$(eval mode == 'scan')"
           file="$(find uav_lidar_dqn_navigation)/launch/scan.launch">
    <arg name="airsim_ip" value="$(arg airsim_ip)"/>
    <arg name="vehicle_name" value="$(arg vehicle_name)"/>
  </include>

  <include if="$(eval mode == 'dqn')"
           file="$(find uav_lidar_dqn_navigation)/launch/dqn.launch">
    <arg name="airsim_ip" value="$(arg airsim_ip)"/>
    <arg name="vehicle_name" value="$(arg vehicle_name)"/>
  </include>

  <include if="$(eval mode == 'slam')"
           file="$(find uav_lidar_dqn_navigation)/launch/slam.launch">
    <arg name="airsim_ip" value="$(arg airsim_ip)"/>
    <arg name="vehicle_name" value="$(arg vehicle_name)"/>
  </include>

  <include if="$(eval mode == 'e2e')"
           file="$(find uav_lidar_dqn_navigation)/launch/e2e.launch">
    <arg name="airsim_ip" value="$(arg airsim_ip)"/>
    <arg name="vehicle_name" value="$(arg vehicle_name)"/>
  </include>
</launch>
