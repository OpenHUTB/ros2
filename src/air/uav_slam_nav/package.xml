<?xml version="1.0"?>
<package format="2">
  <name>uav_slam_nav</name>
  <version>0.0.1</version>
  <description>
    无人机在线 SLAM 建图与目标点导航：把 carlair_ros_bridge 发布的世界系
    LiDAR 点云投影成 /scan，喂给 RTAB-Map 在线建图；再由 move_base 在
    占据栅格上做全局/局部规划，把速度指令转发到 /uav/cmd_vel。
  </description>
  <maintainer email="enemy@example.com">enemy</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>move_base</depend>
  <depend>rtabmap_ros</depend>
  <depend>carlair_ros_bridge</depend>
</package>
