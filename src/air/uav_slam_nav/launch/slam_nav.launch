<launch>
  <!-- ============================================================
       任务③：无人机在线 SLAM 建图 + move_base 目标点导航
       前置：roslaunch carlair_ros_bridge main.launch 已启动并连上仿真器
       链路：
         /lidar/points -> points_to_scan -> /scan
         /uav/odom    -> (odom TF: world -> base_link)
         /scan + odom -> slam_toolbox -> /map + map->world TF
         /map + /scan -> move_base -> /cmd_vel
         /cmd_vel -> nav_relay -> /uav/cmd_vel
       ============================================================ -->

  <!-- 世界系 LiDAR 点云 -> base_link 系 /scan -->
  <node pkg="uav_slam_nav" type="points_to_scan.py" name="points_to_scan" output="screen">
    <param name="height_lo" value="-0.3"/>
    <param name="height_hi" value="3.0"/>
  </node>

  <!-- SLAM Toolbox 异步建图 -->
  <node pkg="slam_toolbox" type="async_slam_toolbox_node" name="slam_toolbox" output="screen">
    <param name="odom_frame" value="world"/>
    <param name="base_frame" value="base_link"/>
    <param name="map_frame" value="map"/>
    <param name="scan_topic" value="/scan"/>
    <param name="resolution" value="0.1"/>
    <param name="max_laser_range" value="20.0"/>
    <param name="min_laser_range" value="0.5"/>
    <param name="transform_publish_period" value="0.05"/>
    <param name="map_update_interval" value="1.0"/>
    <param name="use_scan_matching" value="true"/>
    <param name="minimum_travel_distance" value="0.3"/>
    <param name="minimum_travel_heading" value="0.2"/>
    <param name="loop_search_maximum_distance" value="3.0"/>
    <param name="do_loop_closing" value="true"/>
    <param name="match_num_beams" value="100"/>
    <param name="transform_tolerance" value="0.2"/>
    <param name="tf_buffer_duration" value="20.0"/>
  </node>

  <!-- move_base 导航 -->
  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <remap from="/odom" to="/uav/odom"/>
    <rosparam command="load" file="$(find uav_slam_nav)/config/costmap.yaml"/>
    <param name="odom_frame" value="world"/>
    <param name="base_frame" value="base_link"/>
    <param name="global_frame" value="map"/>
    <param name="base_global_planner" value="global_planner/GlobalPlanner"/>
    <param name="base_local_planner" value="base_local_planner/TrajectoryPlannerROS"/>
    <param name="controller_frequency" value="5.0"/>
    <param name="planner_frequency" value="2.0"/>
    <param name="controller_patience" value="5.0"/>
    <param name="planner_patience" value="5.0"/>
    <param name="shutdown_costmaps" value="false"/>
  </node>

  <!-- move_base 速度 -> /uav/cmd_vel（z 速度清零保持定高） -->
  <node pkg="uav_slam_nav" type="nav_relay.py" name="nav_relay" output="screen"/>
</launch>
