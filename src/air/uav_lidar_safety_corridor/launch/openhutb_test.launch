<launch>
  <arg name="host" default="192.168.94.1"/>
  <arg name="vehicle_name" default="Drone1"/>
  <arg name="publish_image" default="true"/>

  <arg name="goal_x" default="-2.54"/>
  <arg name="goal_y" default="1.60"/>
  <arg name="goal_z" default="3.0"/>

  <!-- One command starts both the AirSim bridge and the safety-corridor node. -->
  <include file="$(find carlair_ros_bridge)/launch/main.launch">
    <arg name="host" value="$(arg host)"/>
    <arg name="vehicle_name" value="$(arg vehicle_name)"/>
    <arg name="body_frame" value="false"/>
    <arg name="publish_image" value="$(arg publish_image)"/>
    <arg name="publish_lidar" value="true"/>
  </include>

  <include file="$(find uav_lidar_safety_corridor)/launch/main.launch">
    <arg name="relative_goal" value="true"/>
    <arg name="goal_x" value="$(arg goal_x)"/>
    <arg name="goal_y" value="$(arg goal_y)"/>
    <arg name="goal_z" value="$(arg goal_z)"/>
  </include>
</launch>
