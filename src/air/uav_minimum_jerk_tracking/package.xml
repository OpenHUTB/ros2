<?xml version="1.0"?>
<package format="2">
  <name>uav_minimum_jerk_tracking</name>
  <version>0.1.0</version>
  <description>
    无人机最小加加速度五次轨迹生成、世界系速度跟踪与线性参考对比实验。
  </description>

  <maintainer email="Qinfy-fly@users.noreply.github.com">Qinfy-fly</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>carlair_ros_bridge</exec_depend>
  <test_depend>python3-nose</test_depend>
</package>
