<launch>
  <arg name="mission" default="straight_3m_up"/>
  <arg name="mode" default="minimum_jerk"
       doc="轨迹模式：minimum_jerk 或 linear"/>

  <rosparam command="load"
            file="$(find uav_minimum_jerk_tracking)/config/params.yaml"/>
  <param name="mission" value="$(arg mission)" type="str"/>
  <param name="trajectory/mode" value="$(arg mode)" type="str"/>

  <node pkg="uav_minimum_jerk_tracking" type="main.py"
        name="uav_minimum_jerk_tracking" output="screen"/>
</launch>
