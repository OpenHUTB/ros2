<launch>
  <arg name="distance_threshold" default="0.2"/>
  <arg name="max_iterations" default="120"/>
  <arg name="min_range" default="0.5"/>
  <arg name="max_range" default="60.0"/>
  <arg name="max_tilt_deg" default="35.0"/>
  <node pkg="uav_lidar_ground_filter" type="ground_filter_node.py"
        name="uav_lidar_ground_filter" output="screen">
    <param name="distance_threshold" value="$(arg distance_threshold)"/>
    <param name="max_iterations" value="$(arg max_iterations)"/>
    <param name="min_range" value="$(arg min_range)"/>
    <param name="max_range" value="$(arg max_range)"/>
    <param name="max_tilt_deg" value="$(arg max_tilt_deg)"/>
  </node>
</launch>
