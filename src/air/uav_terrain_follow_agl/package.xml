<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uav_terrain_follow_agl</name>
  <version>0.1.0</version>
  <description>低空地形跟随：恒定离地高度保持、雷达高度表延迟补偿与 DEM 前馈，MuJoCo 闭环校验</description>
  <maintainer email="327592576+KKK555-MAX@users.noreply.github.com">蒋宇鑫</maintainer>
  <license>MIT</license>

  <!-- ament_python 包按官方模板只需要 <export><build_type>，不加 buildtool_depend；
       ament_python / ament_pytest 都不是 rosdep key，写了会让 rosdep 解析失败。 -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>uav_mujoco_sim</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
