  <sensor>
    <framepos name="uav_position" objtype="body" objname="uav"/>
    <framequat name="uav_orientation" objtype="body" objname="uav"/>
    <velocimeter name="uav_linear_velocity" site="imu_site"/>
    <gyro name="uav_angular_velocity" site="imu_site"/>
  </sensor>
</mujoco>

