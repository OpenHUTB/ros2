#!/usr/bin/env python3
import pathlib
import sys

_prefix = pathlib.Path(__file__).resolve().parents[2]
_site = next(_prefix.glob("lib/python*/site-packages"), None)
if _site is not None:
    sys.path.insert(0, str(_site))

from ros_node import ros_main


if __name__ == "__main__":
    raise SystemExit(ros_main())
