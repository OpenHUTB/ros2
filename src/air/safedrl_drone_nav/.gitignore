# ---- Python caches -------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
.venv/
venv/

# ---- catkin build trees --------------------------------------------------
build/
devel/

# ---- editor / OS ---------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
*~

# ---- run artefacts: generated, never committed ---------------------------
# Everything below is produced by running the pipeline (train.py / evaluate.py
# / export_package.sh).  It is regenerable from source, so it is kept out of
# the repository; regenerate it with the commands in docs/air/safedrl_drone_nav.md.
logs/
*.tfevents*

dist/
*.tar.gz
*.mjb

# ---- model weights -------------------------------------------------------
# Only ONE weight file is tracked - the best-scoring policy used for testing.
# Every other checkpoint (warm-start, intermediate, *_final) is regenerated by
# scripts/train.py and scripts/pretrain_bc.py, so it is ignored here.
checkpoints/*
!checkpoints/best_model.zip

# NOTE: report figures live only in the repository-level
# docs/img/safedrl_drone_nav/.  They are committed once, because they are what
# the course page renders and are not regenerable byte-for-byte across
# matplotlib versions.  No docs/ directory is kept inside this package.
