<mujoco model="safedrl_quadrotor">
  <!--
    Minimal MuJoCo scene for the SafeDRL navigator.

    The quadrotor is a free-floating rigid body.  `mujoco_bridge_node.py`
    applies a world-frame force and yaw torque that implement a first-order
    velocity loop, so the CBF filter sees the same plant abstraction it was
    designed for.  Gates are visual-only (group 2): they must stay flyable and
    are therefore excluded from the ray caster and from contact.
  -->
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.004" integrator="RK4" gravity="0 0 -9.81"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6" specular="0.1 0.1 0.1"/>
  </visual>

  <default>
    <geom contype="1" conaffinity="1" rgba="0.55 0.62 0.72 1"/>
    <default class="visual_only">
      <geom contype="0" conaffinity="0" group="2" rgba="0.15 0.80 0.45 1"/>
    </default>
    <default class="obstacle">
      <geom contype="1" conaffinity="1" rgba="0.80 0.25 0.20 1"/>
    </default>
  </default>

  <worldbody>
    <light name="key" pos="4 0 6" dir="-0.3 0 -1" diffuse="0.8 0.8 0.8"/>

    <!-- arena -->
    <geom name="floor" type="plane" size="20 20 0.1" pos="0 0 0"
          rgba="0.92 0.92 0.92 1"/>
    <geom name="ceiling" type="plane" size="20 20 0.1" pos="0 0 3.2"
          quat="0 1 0 0" rgba="0.85 0.85 0.85 1"/>
    <geom name="wall_north" type="box" size="6.3 0.05 1.6" pos="6.3 1.65 1.6"
          rgba="0.75 0.78 0.82 1"/>
    <geom name="wall_south" type="box" size="6.3 0.05 1.6" pos="6.3 -1.65 1.6"
          rgba="0.75 0.78 0.82 1"/>
    <geom name="wall_west" type="box" size="0.05 1.6 1.6" pos="-0.2 0 1.6"
          rgba="0.75 0.78 0.82 1"/>
    <geom name="wall_east" type="box" size="0.05 1.6 1.6" pos="12.8 0 1.6"
          rgba="0.75 0.78 0.82 1"/>

    <!-- static obstacles: same layout as launch/navigate.launch -->
    <geom name="obstacle_1" class="obstacle" type="sphere" size="0.32"
          pos="3.4 1.1 1.5"/>
    <geom name="obstacle_2" class="obstacle" type="sphere" size="0.38"
          pos="5.9 -1.3 1.4"/>
    <geom name="obstacle_3" class="obstacle" type="sphere" size="0.28"
          pos="7.6 1.4 1.6"/>
    <geom name="obstacle_4" class="obstacle" type="sphere" size="0.35"
          pos="9.8 -0.6 1.5"/>

    <!-- visual gate frames; group 2 keeps them out of the safety ray cast -->
    <geom class="visual_only" type="box" size="0.03 0.03 0.35"
          pos="3.8 -0.32 1.50"/>
    <geom class="visual_only" type="box" size="0.03 0.03 0.35"
          pos="3.8 0.32 1.50"/>
    <geom class="visual_only" type="box" size="0.03 0.32 0.03"
          pos="3.8 0 1.85"/>
    <geom class="visual_only" type="box" size="0.03 0.32 0.03"
          pos="3.8 0 1.15"/>

    <geom class="visual_only" type="box" size="0.03 0.03 0.35"
          pos="7.4 1.23 1.95"/>
    <geom class="visual_only" type="box" size="0.03 0.03 0.35"
          pos="7.4 1.87 1.95"/>
    <geom class="visual_only" type="box" size="0.03 0.32 0.03"
          pos="7.4 1.55 2.30"/>
    <geom class="visual_only" type="box" size="0.03 0.32 0.03"
          pos="7.4 1.55 1.60"/>

    <geom class="visual_only" type="box" size="0.03 0.03 0.35"
          pos="11.0 -1.87 1.15"/>
    <geom class="visual_only" type="box" size="0.03 0.03 0.35"
          pos="11.0 -1.23 1.15"/>
    <geom class="visual_only" type="box" size="0.03 0.32 0.03"
          pos="11.0 -1.55 1.50"/>
    <geom class="visual_only" type="box" size="0.03 0.32 0.03"
          pos="11.0 -1.55 0.80"/>

    <!-- free-flying quadrotor -->
    <body name="quadrotor" pos="0 0 1.5">
      <freejoint name="root"/>
      <inertial pos="0 0 0" mass="0.027" diaginertia="1.4e-5 1.4e-5 2.8e-5"/>
      <geom name="body" type="box" size="0.08 0.08 0.02"
            rgba="0.12 0.35 0.80 1"/>
      <geom name="rotor_1" type="cylinder" size="0.05 0.005"
            pos="0.06 0.06 0.025" rgba="0.20 0.20 0.22 1"/>
      <geom name="rotor_2" type="cylinder" size="0.05 0.005"
            pos="0.06 -0.06 0.025" rgba="0.20 0.20 0.22 1"/>
      <geom name="rotor_3" type="cylinder" size="0.05 0.005"
            pos="-0.06 0.06 0.025" rgba="0.20 0.20 0.22 1"/>
      <geom name="rotor_4" type="cylinder" size="0.05 0.005"
            pos="-0.06 -0.06 0.025" rgba="0.20 0.20 0.22 1"/>
      <site name="imu" pos="0 0 0" size="0.005"/>
    </body>
  </worldbody>
</mujoco>
