# Normalise line endings.  The deployment target is an Ubuntu/ROS machine, so
# shell scripts and Python sources must arrive with LF - a CRLF shebang makes
# `./export_package.sh` fail with "bad interpreter: /bin/bash^M".
* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.launch text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.xml   text eol=lf
*.txt   text eol=lf
*.md    text eol=lf

# Binary artefacts: never touch these.
*.png   binary
*.zip   binary
*.npz   binary
*.gz    binary
*.tar.gz binary
