<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uav_neural_safety_filter</name>
  <version>0.1.0</version>
  <description>
    神经安全过滤器。订阅 360° 激光点云与标称速度指令，用距离栅格与神经网络
    修正会撞上障碍的指令；几何 CBF 层作为监督信号与上界。
    依赖 uav_mujoco_sim 提供 /lidar/points、/uav/odom 与 /uav/cmd_vel。
  </description>
  <maintainer email="eeexty@users.noreply.github.com">eeexty</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>uav_mujoco_sim</exec_depend>

  <test_depend>ament_pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
