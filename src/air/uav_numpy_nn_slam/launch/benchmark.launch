<launch>
  <!-- UVNN headless benchmark: UAV sim + metrics, no viewer, auto shutdown -->
  <arg name="scene"     default="city"/>
  <arg name="seed"      default="20261110"/>
  <arg name="noise"     default="true"/>
  <arg name="duration"  default="90.0"/>
  <arg name="mode"      default="BENCHMARK"/>
  <arg name="goal_x"    default=""/>
  <arg name="goal_y"    default=""/>
  <arg name="goal_alt"  default=""/>
  <arg name="timeout"   default="90.0"/>

  <node pkg="uav_numpy_nn_slam" type="sim_node.py" name="sim_node" output="screen">
    <env name="UVNN_ROOT" value="$(find uav_numpy_nn_slam)"/>
    <param name="scene"    value="$(arg scene)"/>
    <param name="seed"     value="$(arg seed)"/>
    <param name="noise"    value="$(arg noise)"/>
    <param name="duration" value="$(arg duration)"/>
    <param name="mode"     value="$(arg mode)"/>
    <param name="state_hz" value="20.0"/>
    <param name="sensor_hz" value="10.0"/>
  </node>

  <node pkg="uav_numpy_nn_slam" type="metrics_node.py" name="metrics_node"
        output="screen" required="true">
    <env name="UVNN_ROOT" value="$(find uav_numpy_nn_slam)"/>
    <param name="scene"      value="$(arg scene)"/>
    <param name="mode"       value="benchmark"/>
    <param name="goal_x"     value="$(arg goal_x)"/>
    <param name="goal_y"     value="$(arg goal_y)"/>
    <param name="goal_alt"   value="$(arg goal_alt)"/>
    <param name="timeout"    value="$(arg timeout)"/>
    <param name="shutdown"   value="true"/>
  </node>
</launch>
