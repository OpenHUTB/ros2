<mujoco model="uav depth avoidance scene">
  <!-- 一个简化四旋翼：单个刚体 + freejoint，四个旋翼只作为执行器参考点。
       控制律在 Python 里实现（速度伺服），物理积分由 MuJoCo 完成。 -->
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.005" gravity="0 0 -9.81" integrator="RK4"/>

  <visual>
    <global offwidth="960" offheight="720"/>
    <headlight ambient="0.45 0.45 0.45" diffuse="0.6 0.6 0.6"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.25 0.27 0.30" rgb2="0.35 0.38 0.42"
             width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="8 8" reflectance="0.05"/>
    <material name="wall" rgba="0.55 0.58 0.62 1"/>
    <material name="obst" rgba="0.85 0.45 0.25 1"/>
    <material name="uav" rgba="0.20 0.55 0.90 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 8" dir="0 0 -1" diffuse="0.7 0.7 0.7"/>
    <geom name="floor" type="plane" size="18 18 0.1" material="grid"/>

    <!-- 场景：两侧墙 + 若干柱状障碍，形成一条带岔路的走廊（见 scene 说明文档） -->
    <geom name="wall_left" type="box" pos="6 3.2 1.2" size="8 0.15 1.2" material="wall"/>
    <geom name="wall_right" type="box" pos="6 -3.2 1.2" size="8 0.15 1.2" material="wall"/>
    <geom name="end_wall" type="box" pos="14.5 0 1.2" size="0.15 3.4 1.2" material="wall"/>

    <!-- 六个柱状障碍：位置由 env.py 按场景（走廊 / 门洞 / 散乱）在运行时设置，
         因此同一个 XML 可以复用三种布局，不需要为每个场景复制一份模型。 -->
    <geom name="post0" type="cylinder" pos="3.0 1.2 1.5" size="0.22 1.5" material="obst"/>
    <geom name="post1" type="cylinder" pos="5.0 -1.2 1.5" size="0.22 1.5" material="obst"/>
    <geom name="post2" type="cylinder" pos="7.0 1.2 1.5" size="0.22 1.5" material="obst"/>
    <geom name="post3" type="cylinder" pos="9.0 -1.2 1.5" size="0.22 1.5" material="obst"/>
    <geom name="post4" type="cylinder" pos="11.0 1.2 1.5" size="0.22 1.5" material="obst"/>
    <geom name="post5" type="cylinder" pos="13.0 -1.2 1.5" size="0.22 1.5" material="obst"/>

    <body name="uav" pos="0 0 1.5">
      <freejoint name="uav_free"/>
      <geom name="uav_body" type="box" size="0.16 0.16 0.05" mass="1.0" material="uav"/>
      <geom name="uav_arm_x" type="box" size="0.22 0.02 0.01" mass="0.06" material="uav"/>
      <geom name="uav_arm_y" type="box" size="0.02 0.22 0.01" mass="0.06" material="uav"/>
      <!-- 前视深度相机：-z_cam 指向 +x（机头），+y_cam 指向 +z（上），+x_cam 指向 -y（右侧） -->
      <camera name="depth_cam" pos="0.18 0 0.02" quat="0.5 0.5 -0.5 -0.5"
              fovy="80" resolution="64 64"/>
      <camera name="chase_cam" pos="-1.2 0 0.7" quat="0.5 0.5 -0.5 -0.5" fovy="70"/>
    </body>
  </worldbody>
</mujoco>
