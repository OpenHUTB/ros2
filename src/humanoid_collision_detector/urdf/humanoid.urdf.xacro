<?xml version="1.0"?>
<!--
  humanoid.urdf.xacro
-->
<robot name="humanoid_demo" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============ Link: head ============ -->
  <link name="head">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.22 0.22 0.22"/></geometry>
      <material name="silver"><color rgba="0.7 0.7 0.7 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.22 0.22 0.22"/></geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.008" ixy="0.0" ixz="0.0" iyy="0.008" iyz="0.0" izz="0.008"/>
    </inertial>
  </link>

  <!-- ============ Link: torso ============ -->
  <link name="torso">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.45 0.25 0.6"/></geometry>
      <material name="body"><color rgba="0.3 0.4 0.5 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.45 0.25 0.6"/></geometry>
    </collision>
    <inertial>
      <mass value="20.0"/>
      <inertia ixx="0.5" ixy="0.0" ixz="0.0" iyy="0.3" iyz="0.0" izz="0.2"/>
    </inertial>
  </link>

  <!-- ============ Link: L_upper_arm ============ -->
  <link name="L_upper_arm">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.35"/></geometry>
      <material name="body"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.35"/></geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.002"/>
    </inertial>
  </link>

  <!-- ============ Link: L_forearm ============ -->
  <link name="L_forearm">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.3"/></geometry>
      <material name="body"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.3"/></geometry>
    </collision>
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.005" ixy="0.0" ixz="0.0" iyy="0.005" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <!-- ============ Link: R_upper_arm ============ -->
  <link name="R_upper_arm">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.35"/></geometry>
      <material name="body"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.35"/></geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.002"/>
    </inertial>
  </link>

  <!-- ============ Link: R_forearm ============ -->
  <link name="R_forearm">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.3"/></geometry>
      <material name="body"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.3"/></geometry>
    </collision>
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.005" ixy="0.0" ixz="0.0" iyy="0.005" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <!-- ============ Link: L_thigh ============ -->
  <link name="L_thigh">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.06" length="0.45"/></geometry>
      <material name="body"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.06" length="0.45"/></geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.03" ixy="0.0" ixz="0.0" iyy="0.03" iyz="0.0" izz="0.005"/>
    </inertial>
  </link>

  <!-- ============ Link: L_shank ============ -->
  <link name="L_shank">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.35"/></geometry>
      <material name="body"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.35"/></geometry>
    </collision>
    <inertial>
      <mass value="3.0"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.003"/>
    </inertial>
  </link>

  <!-- ============ Link: L_foot ============ -->
  <link name="L_foot">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.14 0.22 0.06"/></geometry>
      <material name="foot"><color rgba="0.2 0.2 0.2 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.14 0.22 0.06"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.005" ixy="0.0" ixz="0.0" iyy="0.003" iyz="0.0" izz="0.003"/>
    </inertial>
  </link>

  <!-- ============ Link: R_thigh ============ -->
  <link name="R_thigh">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.06" length="0.45"/></geometry>
      <material name="body"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.06" length="0.45"/></geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.03" ixy="0.0" ixz="0.0" iyy="0.03" iyz="0.0" izz="0.005"/>
    </inertial>
  </link>

  <!-- ============ Link: R_shank ============ -->
  <link name="R_shank">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.35"/></geometry>
      <material name="body"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.35"/></geometry>
    </collision>
    <inertial>
      <mass value="3.0"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.003"/>
    </inertial>
  </link>

  <!-- ============ Link: R_foot ============ -->
  <link name="R_foot">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.14 0.22 0.06"/></geometry>
      <material name="foot"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.14 0.22 0.06"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.005" ixy="0.0" ixz="0.0" iyy="0.003" iyz="0.0" izz="0.003"/>
    </inertial>
  </link>

  <!-- ============ 关节连接 (模拟人体结构) ============ -->
  <!-- world -> torso -->
  <joint name="world_to_torso" type="fixed">
    <parent link="world"/>
    <child link="torso"/>
    <origin xyz="0 0 1.25" rpy="0 0 0"/>
  </joint>

  <!-- torso -> head -->
  <joint name="torso_to_head" type="fixed">
    <parent link="torso"/>
    <child link="head"/>
    <origin xyz="0 0 0.65" rpy="0 0 0"/>
  </joint>

  <!-- torso -> arms -->
  <joint name="torso_to_L_upper_arm" type="revolute">
    <parent link="torso"/>
    <child link="L_upper_arm"/>
    <origin xyz="-0.32 0 0.2" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
  </joint>
  <joint name="L_upper_arm_to_L_forearm" type="revolute">
    <parent link="L_upper_arm"/>
    <child link="L_forearm"/>
    <origin xyz="0 0 -0.35" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="8" velocity="1.0"/>
  </joint>

  <joint name="torso_to_R_upper_arm" type="revolute">
    <parent link="torso"/>
    <child link="R_upper_arm"/>
    <origin xyz="0.32 0 0.2" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
  </joint>
  <joint name="R_upper_arm_to_R_forearm" type="revolute">
    <parent link="R_upper_arm"/>
    <child link="R_forearm"/>
    <origin xyz="0 0 -0.35" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="8" velocity="1.0"/>
  </joint>

  <!-- torso -> legs -->
  <joint name="torso_to_L_thigh" type="revolute">
    <parent link="torso"/>
    <child link="L_thigh"/>
    <origin xyz="-0.13 0 -0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="20" velocity="0.8"/>
  </joint>
  <joint name="L_thigh_to_L_shank" type="revolute">
    <parent link="L_thigh"/>
    <child link="L_shank"/>
    <origin xyz="0 0 -0.45" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="0" effort="15" velocity="0.8"/>
  </joint>
  <joint name="L_shank_to_L_foot" type="fixed">
    <parent link="L_shank"/>
    <child link="L_foot"/>
    <origin xyz="0 0 -0.38" rpy="0 0 0"/>
  </joint>

  <joint name="torso_to_R_thigh" type="revolute">
    <parent link="torso"/>
    <child link="R_thigh"/>
    <origin xyz="0.13 0 -0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="20" velocity="0.8"/>
  </joint>
  <joint name="R_thigh_to_R_shank" type="revolute">
    <parent link="R_thigh"/>
    <child link="R_shank"/>
    <origin xyz="0 0 -0.45" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="0" effort="15" velocity="0.8"/>
  </joint>
  <joint name="R_shank_to_R_foot" type="fixed">
    <parent link="R_shank"/>
    <child link="R_foot"/>
    <origin xyz="0 0 -0.38" rpy="0 0 0"/>
  </joint>

</robot>
