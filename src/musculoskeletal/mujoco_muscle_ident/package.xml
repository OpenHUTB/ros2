<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mujoco_muscle_ident</name>
  <version>0.1.0</version>
  <description>
    肌肉参数辨识：用关节轨迹反演 F_max / l_opt / tau_act / 矩臂 / 阻尼，
    并给出噪声敏感性、参数相关性与初值敏感性。依赖 MuJoCo 正模型。
  </description>
  <maintainer email="VirtuosaHutb@users.noreply.github.com">VirtuosaHutb</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <buildtool_depend>ament_index_python</buildtool_depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>mujoco</exec_depend>

  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

