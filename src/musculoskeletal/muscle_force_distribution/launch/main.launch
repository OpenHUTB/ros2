<?xml version="1.0"?>
<launch>
  <!--
    肌肉冗余力分配仿真演示。模块本身只用 Python 标准库，不依赖 rospy，
    这里用 launch 统一入口与输出目录，便于和其他模块一样被 roslaunch 拉起。

    用法：
      roslaunch muscle_force_distribution main.launch
    这里不写以减号开头的命令行示例：XML 注释内不允许连续两个减号。
  -->

  <arg name="args" default="" />
  <arg name="outdir" default="$(find muscle_force_distribution)/demo_out" />

  <node
    pkg="muscle_force_distribution"
    type="main.py"
    name="muscle_force_distribution"
    output="screen"
    args="$(arg args) --outdir $(arg outdir)"
  />

</launch>
