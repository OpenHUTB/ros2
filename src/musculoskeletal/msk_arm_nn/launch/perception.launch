<launch>
  <!-- MSK-Arm depth perception: sim + neural depth denoiser + viewer -->
  <arg name="scene"          default="reach"/>
  <arg name="seed"           default="20261111"/>
  <arg name="noise"          default="true"/>
  <arg name="display"        default=":0"/>
  <arg name="viewer"         default="true"/>
  <arg name="duration"       default="0.0"/>
  <arg name="mode"           default="PERCEPTION"/>
  <arg name="model"          default="$(find msk_arm_nn)/models/perception_mlp.npz"/>
  <arg name="auto_snapshot"  default=""/>
  <arg name="render_width"   default="760"/>

  <node pkg="msk_arm_nn" type="sim_node.py" name="sim_node" output="screen">
    <env name="MSK_ROOT" value="$(find msk_arm_nn)"/>
    <param name="scene"    value="$(arg scene)"/>
    <param name="seed"     value="$(arg seed)"/>
    <param name="noise"    value="$(arg noise)"/>
    <param name="duration" value="$(arg duration)"/>
    <param name="mode"     value="$(arg mode)"/>
    <param name="state_hz" value="20.0"/>
    <param name="camera_hz" value="10.0"/>
  </node>

  <node pkg="msk_arm_nn" type="perception_node.py" name="perception_node"
        output="screen">
    <env name="MSK_ROOT" value="$(find msk_arm_nn)"/>
    <param name="model" value="$(arg model)"/>
  </node>

  <node if="$(arg viewer)" pkg="msk_arm_nn" type="viewer_node.py"
        name="viewer_node" output="screen">
    <env name="DISPLAY"    value="$(arg display)"/>
    <env name="MSK_ROOT"   value="$(find msk_arm_nn)"/>
    <param name="scene"         value="$(arg scene)"/>
    <param name="teleop"        value="false"/>
    <param name="display"       value="$(arg display)"/>
    <param name="auto_snapshot" value="$(arg auto_snapshot)"/>
    <param name="render_width"  value="$(arg render_width)"/>
  </node>
</launch>
