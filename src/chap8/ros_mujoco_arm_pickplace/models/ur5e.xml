<mujoco model="ur5_pickplace">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81" cone="elliptic" impratio="10"/>

  <default>
    <!-- armature 提供关节等效惯量，damping 抑制高频振荡（稳定关键） -->
    <joint armature="0.01" damping="3.0"/>
  </default>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" diffuse="1 1 1" specular="0.2 0.2 0.2"/>
    <light pos="1.5 1.5 2" dir="-0.5 -0.5 -1" diffuse="0.6 0.6 0.6"/>

    <!-- 地面：必须保留碰撞，方块靠它支撑 -->
    <geom name="ground" type="plane" size="3 3 0.1" rgba="0.9 0.9 0.9 1" contype="1" conaffinity="1"/>

    <!-- 放置目标标记（绿色小方块） -->
    <site name="place_target" pos="-0.4 0 0.05" size="0.02 0.02 0.02" rgba="0 1 0 1"/>

    <!-- 被抓取的方块：freejoint 让它能自由运动 -->
    <body name="cube" pos="0.4 0 0.05">
      <freejoint name="cube_free"/>
      <geom type="box" size="0.04 0.04 0.04" rgba="0.9 0.3 0.3 1" mass="0.1"/>
    </body>

    <!-- 机械臂：所有连杆 geom contype=0，关闭连杆间自碰撞；显式质量避免默认密度过重 -->
    <body name="base" pos="0 0 0">
      <geom type="box" size="0.15 0.15 0.1" rgba="0.5 0.5 0.5 1" contype="0" conaffinity="0" mass="0.8"/>
      <body name="shoulder" pos="0 0 0.2">
        <joint name="shoulder_pan_joint" type="hinge" axis="0 0 1" range="-3.14 3.14"/>
        <geom type="cylinder" size="0.06 0.1" fromto="0 0 0 0 0 0.2" rgba="0.2 0.6 0.3 1" contype="0" conaffinity="0" mass="0.6"/>
        <body name="upper_arm" pos="0 0 0.2">
          <joint name="shoulder_lift_joint" type="hinge" axis="0 1 0" range="-1.6 1.6"/>
          <geom type="cylinder" size="0.05 0.4" fromto="0 0 0 0 0 0.4" rgba="0.3 0.5 0.8 1" contype="0" conaffinity="0" mass="0.8"/>
          <body name="forearm" pos="0 0 0.4">
            <joint name="elbow_joint" type="hinge" axis="0 1 0" range="-2.8 2.8"/>
            <geom type="cylinder" size="0.04 0.35" fromto="0 0 0 0 0 0.35" rgba="0.8 0.4 0.2 1" contype="0" conaffinity="0" mass="0.6"/>
            <body name="wrist" pos="0 0 0.35">
              <joint name="wrist_1_joint" type="hinge" axis="0 1 0" range="-1.2 1.2"/>
              <geom type="sphere" size="0.045" rgba="0.6 0.2 0.6 1" contype="0" conaffinity="0" mass="0.3"/>
              <body name="ee_link" pos="0 0 0.08">
                <joint name="wrist_2_joint" type="hinge" axis="0 0 1" range="-3.14 3.14"/>
                <geom type="box" size="0.035 0.035 0.035" rgba="0.9 0.2 0.2 1" contype="0" conaffinity="0" mass="0.15"/>
                <!-- 末端执行器参考点：IK 与抓取距离判定的基准 -->
                <site name="ee_site" pos="0 0 0" size="0.01" rgba="1 1 0 1"/>
                <!-- 夹爪（视觉装饰；物理抓取由代码侧“运动学硬连接”实现） -->
                <body name="gripper" pos="0 0 0.04">
                  <joint name="gripper_joint" type="hinge" axis="1 0 0" range="0 1.2"/>
                  <geom type="box" size="0.03 0.015 0.015" rgba="0.1 0.1 0.1 1" contype="0" conaffinity="0" mass="0.05"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- weld 约束仅作参考保留（mujoco>=3.17 实测约束雅可比异常），
       实际抓取由代码侧每子步把方块位姿锁定到 ee 参考系（运动学硬连接） -->
  <equality>
    <weld name="grasp_weld" body1="ee_link" body2="cube" active="false"/>
  </equality>

  <!-- position 伺服：ctrl 直接是目标关节角，内部自带 PD 闭环 -->
  <actuator>
    <position name="pos_pan"    joint="shoulder_pan_joint" kp="120" kv="15"/>
    <position name="pos_lift"   joint="shoulder_lift_joint" kp="150" kv="20"/>
    <position name="pos_elbow"  joint="elbow_joint" kp="120" kv="16"/>
    <position name="pos_wrist1" joint="wrist_1_joint" kp="50" kv="8"/>
    <position name="pos_wrist2" joint="wrist_2_joint" kp="50" kv="8"/>
    <position name="pos_gripper" joint="gripper_joint" kp="30" kv="4"/>
  </actuator>
</mujoco>
