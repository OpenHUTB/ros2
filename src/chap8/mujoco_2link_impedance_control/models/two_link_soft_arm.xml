<mujoco model="two_link_arm">
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <default>
    <geom condim="4" friction="0.7 0.01 0.1" solimp="0.5 0.7 0.01" solref="0.1 1"/>
  </default>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <camera name="global_view" pos="1.5 -1.5 1.2" euler="45 0 45"/>

    <geom name="floor" type="plane" size="3 3 0.1" rgba="0.25 0.25 0.25 1"/>

    <!-- 墙面：在 tip 伸直路径上 -->
    <body name="wall" pos="0.60 0 0.20">
      <geom type="box" size="0.02 0.06 0.04" rgba="0.3 0.8 0.3 1"/>
    </body>

    <!-- 机械臂基座：矮底座，link1 抬高避免自碰撞 -->
    <body name="base" pos="0 0 0.15">
      <geom type="box" size="0.05 0.05 0.03" rgba="0.4 0.4 0.4 1" mass="2"/>
      <body name="link1" pos="0 0 0.05">
        <joint name="joint1" type="hinge" axis="0 0 1" range="-3.14 3.14" limited="true"/>
        <geom type="cylinder" size="0.02 0.3" fromto="0 0 0 0.3 0 0" rgba="0.6 0.7 0.8 1" mass="1"/>
        <body name="link2" pos="0.3 0 0">
          <joint name="joint2" type="hinge" axis="0 0 1" range="-3.14 3.14" limited="true"/>
          <geom type="cylinder" size="0.018 0.28" fromto="0 0 0 0.28 0 0" rgba="0.7 0.5 0.6 1" mass="0.8"/>
          <body name="tip" pos="0.28 0 0">
            <geom type="sphere" size="0.025" rgba="0.9 0.3 0.3 1" mass="0.2"/>
            <site name="end_effector" pos="0 0 0" size="0.01" rgba="1 1 0 1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="motor1" joint="joint1" gear="1"/>
    <motor name="motor2" joint="joint2" gear="1"/>
  </actuator>

  <sensor>
    <force name="force_sensor" site="end_effector"/>
  </sensor>

  <keyframe>
    <key name="home" qpos="0.5 -0.5"/>
  </keyframe>
</mujoco>
