<?xml version="1.0"?>
<launch>
  <!-- ROS 2 XML launch。两个关键点：
       1) <node> 用 exec= 指定可执行文件（ROS 1 的 type= 在 ROS 2 里会报 invalid attribute）；
       2) 节点参数必须用 <param> 子元素，不能写成 <node> 的属性。 -->
  <arg name="rate" default="50.0" description="控制频率 (Hz)"/>
  <node pkg="idm_car_following" exec="ros_node.py" name="idm_car_following_demo" output="screen">
    <param name="rate" value="$(var rate)"/>
  </node>
</launch>
