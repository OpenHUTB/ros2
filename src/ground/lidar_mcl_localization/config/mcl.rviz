Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Map1
        - /Particles1
        - /LaserScan1
      Splitter Ratio: 0.5
    Tree Height: 640
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid1
      Enabled: true
      Cell Size: 1
      Color: 160; 160; 164
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/Map
      Name: Map1
      Enabled: true
      Topic: /map
      Alpha: 0.75
      Color Scheme: map
      Draw Behind: true
      Value: true
    - Class: rviz/PoseArray
      Name: Particles1
      Enabled: true
      Topic: /particles
      Color: 255; 160; 30
      Alpha: 0.55
      Arrow Length: 0.20
      Arrow Width: 0.04
      Axes Length: 0.10
      Axes Radius: 0.015
      Shape: Arrow (Flat)
      Value: true
    - Class: rviz/LaserScan
      Name: LaserScan1
      Enabled: true
      Topic: /scan
      Color: 220; 60; 60
      Size (m): 0.03
      Style: Flat Squares
      Value: true
    - Class: rviz/PoseWithCovariance
      Name: MCLPose1
      Enabled: true
      Topic: /mcl_pose
      Color: 20; 200; 60
      Alpha: 1
      Covariance:
        Position:
          Value: true
          Color: 20; 200; 60
          Alpha: 0.6
        Orientation:
          Value: true
          Color: 20; 200; 60
          Alpha: 0.6
      Value: true
    - Class: rviz/TF
      Name: TF1
      Enabled: true
      Marker Scale: 0.5
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Value: true
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Current View
      Scale: 60
      Target Frame: <Fixed Frame>
      X: 0
      Y: 0
      Angle: 0
      Near Clip Distance: 0.01
      Value: TopDownOrtho (rviz)
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
  Displays:
    collapsed: false
