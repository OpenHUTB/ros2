<?xml version="1.0"?>
<!--
  一条命令跑完：Gazebo 场景 + 机器人 + 地图发布 + MCL 定位节点。

  用法：
    roslaunch lidar_mcl_localization main.launch                        # 无头（没有显卡也能跑）
    roslaunch lidar_mcl_localization main.launch gui:=true              # 带 Gazebo 界面
    roslaunch lidar_mcl_localization main.launch gui:=true rviz:=true   # 再开 rviz 看粒子云
-->
<launch>
  <arg name="gui" default="false"/>
  <arg name="rviz" default="false"/>
  <arg name="num_particles" default="600"/>
  <arg name="global_localization" default="false"/>
  <arg name="world" default="$(find lidar_mcl_localization)/worlds/mcl_room.world"/>
  <arg name="map" default="$(find lidar_mcl_localization)/maps/mcl_room.pgm"/>

  <include file="$(find lidar_mcl_localization)/launch/sim.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="world" value="$(arg world)"/>
  </include>

  <!-- 地图：自己发 /map（不依赖 map_server，虚拟机里可能没装） -->
  <node pkg="lidar_mcl_localization" type="map_publisher.py" name="mcl_map_publisher"
        output="screen">
    <param name="map_file" value="$(arg map)"/>
  </node>

  <node pkg="lidar_mcl_localization" type="mcl_node.py" name="mcl_node" output="screen">
    <param name="map_file" value="$(arg map)"/>
    <param name="num_particles" value="$(arg num_particles)"/>
    <param name="global_localization" value="$(arg global_localization)"/>
    <param name="init_pose" type="yaml" value="[-3.5, 0.0, 0.0]"/>
    <param name="init_std" type="yaml" value="[0.30, 0.30, 0.15]"/>
    <param name="alpha" type="yaml" value="[0.12, 0.03, 0.12, 0.03]"/>
    <param name="sigma" value="0.20"/>
    <param name="beam_step" value="8"/>
    <param name="max_range" value="8.0"/>
    <param name="resample_ratio" value="0.5"/>
    <param name="ground_truth_model" value="mcl_bot"/>
    <param name="publish_tf" value="true"/>
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find lidar_mcl_localization)/config/mcl.rviz"/>
</launch>
