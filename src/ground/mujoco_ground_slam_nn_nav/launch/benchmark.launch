<launch>
  <!-- Headless benchmark run (no OpenCV viewer). -->
  <arg name="scene" default="warehouse"/>
  <arg name="seed" default="20261026"/>
  <arg name="mode" default="classical"/>
  <arg name="duration" default="90"/>
  <include file="$(find mujoco_ground_slam_nn_nav)/launch/slam_nav.launch">
    <arg name="scene" value="$(arg scene)"/>
    <arg name="seed" value="$(arg seed)"/>
    <arg name="viewer" value="false"/>
    <arg name="duration" value="$(arg duration)"/>
    <arg name="use_neural_planner" value="$(eval arg('mode') == 'neural')"/>
    <arg name="use_nn_controller" value="$(eval arg('mode') == 'neural')"/>
  </include>
</launch>
