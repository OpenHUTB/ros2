<?xml version="1.0"?>
<robot name="tracked_vehicle" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================ 可调参数 ============================ -->
  <xacro:arg name="enable_camera" default="false"/>

  <xacro:property name="wheel_radius" value="0.08"/>
  <xacro:property name="wheel_width" value="0.06"/>
  <xacro:property name="wheel_separation" value="0.54"/>
  <xacro:property name="base_length" value="0.70"/>
  <xacro:property name="base_width" value="0.50"/>
  <xacro:property name="base_height" value="0.22"/>
  <xacro:property name="track_length" value="0.78"/>
  <xacro:property name="track_width" value="0.12"/>
  <xacro:property name="track_height" value="0.20"/>

  <!-- ============================ 材质 ============================ -->
  <material name="body_orange">
    <color rgba="0.95 0.42 0.08 1.0"/>
  </material>
  <material name="track_dark">
    <color rgba="0.12 0.12 0.13 1.0"/>
  </material>
  <material name="metal_grey">
    <color rgba="0.55 0.57 0.60 1.0"/>
  </material>
  <material name="sensor_blue">
    <color rgba="0.05 0.35 0.85 1.0"/>
  </material>

  <!-- ============================ 惯量宏 ============================ -->
  <xacro:macro name="box_inertia" params="m x y z ox oy oz">
    <inertial>
      <origin xyz="${ox} ${oy} ${oz}" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12.0}" ixy="0.0" ixz="0.0"
               iyy="${m*(x*x+z*z)/12.0}" iyz="0.0"
               izz="${m*(x*x+y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r l ox oy oz">
    <inertial>
      <origin xyz="${ox} ${oy} ${oz}" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+l*l)/12.0}" ixy="0.0" ixz="0.0"
               iyy="${m*(3*r*r+l*l)/12.0}" iyz="0.0"
               izz="${m*r*r/2.0}"/>
    </inertial>
  </xacro:macro>

  <!-- ============================ 车体 ============================ -->
  <link name="base_link">
    <xacro:box_inertia m="18.0" x="${base_length}" y="${base_width}" z="${base_height}"
                       ox="0" oy="0" oz="0.22"/>
    <visual>
      <origin xyz="0 0 0.28" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="body_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.28" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- 车顶传感器桅杆（视觉件，不参与碰撞） -->
  <link name="sensor_mast">
    <visual>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.20"/>
      </geometry>
      <material name="metal_grey"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.22" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.10 0.08"/>
      </geometry>
      <material name="sensor_blue"/>
    </visual>
  </link>
  <joint name="sensor_mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_mast"/>
    <origin xyz="0.12 0 0.39" rpy="0 0 0"/>
  </joint>

  <!-- ============================ 履带（视觉件） ============================ -->
  <link name="left_track">
    <visual>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry>
        <box size="${track_length} ${track_width} ${track_height}"/>
      </geometry>
      <material name="track_dark"/>
    </visual>
    <!-- 履带表面的浅色横向花纹，增强 Gazebo 画面辨识度 -->
    <visual>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <geometry>
        <box size="${track_length} 0.02 0.012"/>
      </geometry>
      <material name="metal_grey"/>
    </visual>
  </link>
  <joint name="left_track_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_track"/>
    <origin xyz="0 0.27 0" rpy="0 0 0"/>
  </joint>

  <link name="right_track">
    <visual>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry>
        <box size="${track_length} ${track_width} ${track_height}"/>
      </geometry>
      <material name="track_dark"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <geometry>
        <box size="${track_length} 0.02 0.012"/>
      </geometry>
      <material name="metal_grey"/>
    </visual>
  </link>
  <joint name="right_track_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_track"/>
    <origin xyz="0 -0.27 0" rpy="0 0 0"/>
  </joint>

  <!-- ============================ 驱动轮 ============================ -->
  <link name="left_wheel">
    <xacro:cylinder_inertia m="1.2" r="${wheel_radius}" l="${wheel_width}"
                            ox="0" oy="0" oz="0"/>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="metal_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.27 ${wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="50.0" velocity="20.0"/>
  </joint>

  <link name="right_wheel">
    <xacro:cylinder_inertia m="1.2" r="${wheel_radius}" l="${wheel_width}"
                            ox="0" oy="0" oz="0"/>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="metal_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.27 ${wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="50.0" velocity="20.0"/>
  </joint>

  <!-- ============================ 前后万向支撑轮 ============================ -->
  <link name="front_caster">
    <xacro:cylinder_inertia m="0.15" r="0.045" l="0.03" ox="0" oy="0" oz="0"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.045"/>
      </geometry>
      <material name="metal_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.045"/>
      </geometry>
    </collision>
  </link>
  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster"/>
    <origin xyz="0.31 0 0.048" rpy="0 0 0"/>
  </joint>

  <link name="rear_caster">
    <xacro:cylinder_inertia m="0.15" r="0.045" l="0.03" ox="0" oy="0" oz="0"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.045"/>
      </geometry>
      <material name="metal_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.045"/>
      </geometry>
    </collision>
  </link>
  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster"/>
    <origin xyz="-0.31 0 0.048" rpy="0 0 0"/>
  </joint>

  <!-- ============================ Gazebo 摩擦参数 ============================ -->
  <gazebo reference="left_wheel">
    <mu1>1.4</mu1>
    <mu2>1.4</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>
  <gazebo reference="right_wheel">
    <mu1>1.4</mu1>
    <mu2>1.4</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>
  <gazebo reference="front_caster">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>
  <gazebo reference="rear_caster">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>
  <gazebo reference="base_link">
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
    <selfCollide>false</selfCollide>
  </gazebo>

  <!-- ============================ 差速驱动插件 ============================ -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <updateRate>50.0</updateRate>
      <leftJoint>left_wheel_joint</leftJoint>
      <rightJoint>right_wheel_joint</rightJoint>
      <wheelSeparation>${wheel_separation}</wheelSeparation>
      <wheelDiameter>${wheel_radius * 2.0}</wheelDiameter>
      <wheelTorque>40.0</wheelTorque>
      <wheelAcceleration>0.0</wheelAcceleration>
      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_link</robotBaseFrame>
      <odometrySource>world</odometrySource>
      <publishWheelTF>false</publishWheelTF>
      <publishWheelJointState>true</publishWheelJointState>
      <rosDebugLevel>na</rosDebugLevel>
    </plugin>
  </gazebo>

  <!-- ============================ IMU 插件 ============================ -->
  <gazebo>
    <plugin name="imu_plugin" filename="libgazebo_ros_imu.so">
      <bodyName>base_link</bodyName>
      <topicName>imu</topicName>
      <serviceName>imu_service</serviceName>
      <gaussianNoise>0.0</gaussianNoise>
      <updateRate>100.0</updateRate>
    </plugin>
  </gazebo>

  <!-- ============================ 可选前置相机 ============================ -->
  <xacro:if value="$(arg enable_camera)">
    <link name="front_camera_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.06 0.10 0.05"/>
        </geometry>
        <material name="sensor_blue"/>
      </visual>
    </link>
    <joint name="front_camera_joint" type="fixed">
      <parent link="sensor_mast"/>
      <child link="front_camera_link"/>
      <origin xyz="0.06 0 0.22" rpy="0 0 0"/>
    </joint>
    <gazebo reference="front_camera_link">
      <sensor type="camera" name="front_camera">
        <update_rate>15.0</update_rate>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>50.0</far>
          </clip>
        </camera>
        <plugin name="front_camera_controller" filename="libgazebo_ros_camera.so">
          <cameraName>front_camera</cameraName>
          <imageTopicName>image_raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <frameName>front_camera_link</frameName>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:if>

</robot>
