<?xml version="1.0"?>
<sdf version="1.6">
  <world name="slope">
    <include>
      <uri>model://sun</uri>
    </include>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>60</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <scene>
      <ambient>0.55 0.55 0.55 1.0</ambient>
      <background>0.72 0.80 0.90 1.0</background>
      <shadows>true</shadows>
    </scene>

    <gui>
      <camera name="user_camera">
        <pose>5.0 -13.0 7.0 0 0.42 1.5708</pose>
      </camera>
    </gui>

    <model name="ground">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>40 20 0.1</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>40 20 0.1</size></box></geometry>
          <material>
            <ambient>0.52 0.53 0.55 1.0</ambient>
            <diffuse>0.62 0.63 0.65 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 10 度斜坡：x=0 处高度为 0，x=12 处高度约 2.116 m -->
    <model name="slope_ramp">
      <static>true</static>
      <pose>6.0 0 0.9595 0 -0.174533 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12 6 0.2</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>12 6 0.2</size></box></geometry>
          <material>
            <ambient>0.42 0.44 0.48 1.0</ambient>
            <diffuse>0.55 0.57 0.60 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 斜坡顶部的水平平台 -->
    <model name="slope_plateau">
      <static>true</static>
      <pose>14.0 0 2.066 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4 6 0.1</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>4 6 0.1</size></box></geometry>
          <material>
            <ambient>0.42 0.44 0.48 1.0</ambient>
            <diffuse>0.55 0.57 0.60 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 斜坡两侧的黄色警示条（纯视觉） -->
    <model name="slope_edge_left">
      <static>true</static>
      <pose>6.0 2.82 1.02 0 -0.174533 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>12 0.08 0.04</size></box></geometry>
          <material><ambient>0.95 0.75 0.05 1.0</ambient><diffuse>1.0 0.82 0.08 1.0</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="slope_edge_right">
      <static>true</static>
      <pose>6.0 -2.82 1.02 0 -0.174533 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>12 0.08 0.04</size></box></geometry>
          <material><ambient>0.95 0.75 0.05 1.0</ambient><diffuse>1.0 0.82 0.08 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="start_line">
      <static>true</static>
      <pose>-1.0 0 0.006 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.12 4.0 0.012</size></box></geometry>
          <material><ambient>0.95 0.75 0.05 1.0</ambient><diffuse>1.0 0.82 0.08 1.0</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
