<?xml version="1.0"?>
<sdf version="1.6">
  <world name="low_friction">
    <include>
      <uri>model://sun</uri>
    </include>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <scene>
      <ambient>0.55 0.55 0.55 1.0</ambient>
      <background>0.70 0.80 0.92 1.0</background>
      <shadows>true</shadows>
    </scene>

    <gui>
      <camera name="user_camera">
        <pose>1.8 -6.0 3.8 0 0.38 1.5708</pose>
      </camera>
    </gui>

    <!-- 低摩擦地面：mu=0.12，模拟湿滑泥地/冰面 -->
    <model name="ground">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20 20 0.1</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>0.12</mu><mu2>0.12</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>20 20 0.1</size></box></geometry>
          <material>
            <ambient>0.18 0.35 0.48 1.0</ambient>
            <diffuse>0.24 0.46 0.62 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="start_line">
      <static>true</static>
      <pose>0.6 0 0.006 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.12 5.0 0.012</size></box></geometry>
          <material><ambient>0.95 0.75 0.05 1.0</ambient><diffuse>1.0 0.82 0.08 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="marker_2m">
      <static>true</static>
      <pose>2.0 2.6 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.10 0.10 0.04</size></box></geometry>
          <material><ambient>0.9 0.2 0.2 1.0</ambient><diffuse>0.9 0.2 0.2 1.0</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="marker_4m">
      <static>true</static>
      <pose>4.0 2.6 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.10 0.10 0.04</size></box></geometry>
          <material><ambient>0.2 0.8 0.2 1.0</ambient><diffuse>0.2 0.8 0.2 1.0</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="marker_6m">
      <static>true</static>
      <pose>6.0 2.6 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.10 0.10 0.04</size></box></geometry>
          <material><ambient>0.2 0.4 0.95 1.0</ambient><diffuse>0.2 0.4 0.95 1.0</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="marker_8m">
      <static>true</static>
      <pose>8.0 2.6 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.10 0.10 0.04</size></box></geometry>
          <material><ambient>0.8 0.3 0.9 1.0</ambient><diffuse>0.8 0.3 0.9 1.0</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
