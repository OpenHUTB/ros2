<?xml version="1.0"?>
<package format="2">
    <name>r2d2_waypoint_cruise</name>
    <version>0.0.1</version>
    <description>
        R2D2 差速小车航点巡航仿真：沿预设方形路径自动导航巡逻，
        使用 P 控制器实现航点跟踪，支持循环巡逻与轨迹记录。
    </description>

    <maintainer email="user@todo.todo">xjm666god</maintainer>
    <license>MIT</license>

    <buildtool_depend>catkin</buildtool_depend>

    <exec_depend>rospy</exec_depend>
    <exec_depend>std_msgs</exec_depend>
</package>
