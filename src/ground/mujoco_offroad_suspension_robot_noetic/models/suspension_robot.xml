    <accelerometer name="accel" site="imu_site"/>
    <framepos name="frame_pos" objtype="site" objname="imu_site"/>
    <framequat name="frame_quat" objtype="site" objname="imu_site"/>
    <jointpos name="sus_fl_pos" joint="sus_j_fl"/>
