<mujoco model="differential drive slam arena">
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.005" gravity="0 0 -9.81" integrator="RK4"/>

  <visual>
    <global offwidth="960" offheight="720"/>
    <headlight ambient="0.45 0.45 0.45" diffuse="0.6 0.6 0.6"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.22 0.24 0.27" rgb2="0.3 0.33 0.36"
             width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="12 12" reflectance="0.05"/>
    <material name="wall" rgba="0.55 0.58 0.62 1"/>
    <material name="pillar" rgba="0.85 0.45 0.25 1"/>
    <material name="robot" rgba="0.2 0.55 0.9 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 8" dir="0 0 -1" diffuse="0.7 0.7 0.7"/>
    <geom name="floor" type="plane" size="10 10 0.1" material="grid"/>

    <!-- 外围墙：12 x 12 米场地 -->
    <geom name="wall_n" type="box" pos="6 6 0.3" size="6.2 0.15 0.3" material="wall"/>
    <geom name="wall_s" type="box" pos="6 -6 0.3" size="6.2 0.15 0.3" material="wall"/>
    <geom name="wall_w" type="box" pos="0 0 0.3" size="0.15 6.2 0.3" material="wall"/>
    <geom name="wall_e" type="box" pos="12 0 0.3" size="0.15 6.2 0.3" material="wall"/>

    <!-- 内部隔断：形成两条走廊 + 一个房间入口 -->
    <geom name="wall_mid_a" type="box" pos="4.0 2.4 0.3" size="0.12 3.6 0.3" material="wall"/>
    <geom name="wall_mid_b" type="box" pos="4.0 -4.4 0.3" size="0.12 1.6 0.3" material="wall"/>
    <geom name="wall_mid_c" type="box" pos="8.0 0.6 0.3" size="0.12 3.0 0.3" material="wall"/>

    <!-- 六个圆柱：既是障碍也是 SLAM 的路标 -->
    <geom name="lm0" type="cylinder" pos="2.0 4.6 0.4" size="0.22 0.4" material="pillar"/>
    <geom name="lm1" type="cylinder" pos="6.2 4.4 0.4" size="0.22 0.4" material="pillar"/>
    <geom name="lm2" type="cylinder" pos="9.8 3.4 0.4" size="0.22 0.4" material="pillar"/>
    <geom name="lm3" type="cylinder" pos="2.6 -2.6 0.4" size="0.22 0.4" material="pillar"/>
    <geom name="lm4" type="cylinder" pos="6.4 -3.8 0.4" size="0.22 0.4" material="pillar"/>
    <geom name="lm5" type="cylinder" pos="9.8 -1.6 0.4" size="0.22 0.4" material="pillar"/>
    <geom name="lm6" type="cylinder" pos="6.0 -5.0 0.4" size="0.22 0.4" material="pillar"/>
    <geom name="lm7" type="cylinder" pos="10.4 2.6 0.4" size="0.22 0.4" material="pillar"/>

    <body name="robot" pos="0.8 0.8 0.12">
      <freejoint name="robot_free"/>
      <geom name="robot_body" type="cylinder" size="0.18 0.08" mass="6.0" material="robot"/>
      <site name="lidar" pos="0 0 0.12" size="0.02"/>
      <camera name="chase_cam" pos="-1.6 0 1.4" quat="0.5 0.5 -0.5 -0.5" fovy="60"/>
    </body>
  </worldbody>
</mujoco>
