<?xml version="1.0"?>
<package format="2">
  <name>lidar_autoencoder_repair</name>
  <version>0.0.1</version>
  <description>基于 PyTorch Autoencoder 的 2D 激光雷达数据修复与避障 ROS 节点。订阅 /scan，通过离线训练的自编码器去除传感器噪声，将修复后的数据送入阈值避障控制逻辑发布 /cmd_vel。</description>
  <maintainer email="3608156082@qq.com">tangwang-0614</maintainer>
  <license>MIT</license>
  <url type="website">https://github.com/OpenHUTB/ros2</url>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>rospy</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <!--
    运行前请安装以下 Python 依赖（不在 apt 仓库中，需要 pip）：
      pip3 install torch numpy
    权重文件 models/autoencoder_weights.pt 随包提供，开箱即用；
    如需重新训练，运行 scripts/train_autoencoder.py 覆盖该文件。
  -->
</package>
