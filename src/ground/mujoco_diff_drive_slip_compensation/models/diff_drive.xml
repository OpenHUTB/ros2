<mujoco model="differential_drive_slip_compensation">
  <compiler angle="radian" coordinate="local"/>
  <option timestep="0.005" gravity="0 0 -9.81" integrator="implicitfast"/>

  <default>
    <joint damping="0.02" armature="0.002"/>
    <geom condim="4" friction="0.8 0.01 0.001" solref="0.02 1"/>
    <motor ctrllimited="true" ctrlrange="-20 20"/>
  </default>

  <worldbody>
    <light name="sun" pos="0 0 4" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="ground" type="plane" size="12 12 0.1" rgba="0.72 0.74 0.76 1"/>
    <body name="chassis" pos="0 0 0.16">
      <freejoint name="chassis_freejoint"/>
      <inertial pos="0 0 0" mass="8.0" diaginertia="0.12 0.20 0.25"/>
      <geom name="chassis_geom" type="box" size="0.30 0.21 0.07" rgba="0.12 0.35 0.58 1"/>
      <site name="imu_site" pos="0 0 0.08" size="0.012" rgba="1 0.8 0 1"/>
      <camera name="tracking_camera" pos="-1.3 0 0.8" xyaxes="0 -1 0 0.5 0 1" mode="trackcom"/>

      <body name="left_front_wheel" pos="0.20 0.24 -0.08">
        <joint name="left_front_joint" type="hinge" axis="0 1 0"/>
        <geom name="left_front_tire" type="cylinder" size="0.08 0.035" euler="1.57079632679 0 0" rgba="0.08 0.08 0.08 1"/>
      </body>
      <body name="left_rear_wheel" pos="-0.20 0.24 -0.08">
        <joint name="left_rear_joint" type="hinge" axis="0 1 0"/>
        <geom name="left_rear_tire" type="cylinder" size="0.08 0.035" euler="1.57079632679 0 0" rgba="0.08 0.08 0.08 1"/>
      </body>
      <body name="right_front_wheel" pos="0.20 -0.24 -0.08">
        <joint name="right_front_joint" type="hinge" axis="0 1 0"/>
        <geom name="right_front_tire" type="cylinder" size="0.08 0.035" euler="1.57079632679 0 0" rgba="0.08 0.08 0.08 1"/>
      </body>
      <body name="right_rear_wheel" pos="-0.20 -0.24 -0.08">
        <joint name="right_rear_joint" type="hinge" axis="0 1 0"/>
        <geom name="right_rear_tire" type="cylinder" size="0.08 0.035" euler="1.57079632679 0 0" rgba="0.08 0.08 0.08 1"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <velocity name="left_front" joint="left_front_joint" kv="2"/>
    <velocity name="left_rear" joint="left_rear_joint" kv="2"/>
    <velocity name="right_front" joint="right_front_joint" kv="2"/>
    <velocity name="right_rear" joint="right_rear_joint" kv="2"/>
  </actuator>
</mujoco>
