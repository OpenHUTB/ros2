<launch>
  <!-- mode: nn（神经网络） | expert（专家） | manual（订阅 /dyn/cmd_vel） -->
  <arg name="mode" default="nn"/>
  <arg name="rate" default="20"/>
  <arg name="seed" default="0"/>

  <node pkg="dyn_avoid_nn" type="dyn_avoid_node.py" name="dyn_avoid_node" output="screen">
    <param name="mode" value="$(arg mode)"/>
    <param name="rate" value="$(arg rate)"/>
    <param name="seed" value="$(arg seed)"/>
    <param name="model_dir" value="$(find dyn_avoid_nn)/models"/>
  </node>
</launch>
