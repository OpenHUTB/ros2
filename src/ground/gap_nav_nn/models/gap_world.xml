<mujoco model="gap_world">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.01" gravity="0 0 -9.81" integrator="Euler"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
    <quality shadowsize="1024"/>
  </visual>

  <asset>
    <texture name="texfloor" type="2d" builtin="checker" rgb1="0.88 0.88 0.86" rgb2="0.83 0.83 0.81"
             width="512" height="512"/>
    <material name="matfloor" texture="texfloor" texrepeat="12 10" reflectance="0.02"/>
    <material name="matrobot" rgba="0.20 0.55 0.85 1"/>
    <material name="matwall"  rgba="0.35 0.34 0.32 1"/>
    <material name="matdiv"   rgba="0.70 0.62 0.50 1"/>
  </asset>

  <worldbody>
    <light name="light" pos="0 0 14" dir="0 0 -1" diffuse="0.9 0.9 0.9"/>

    <!-- 场地 14 m x 12 m -->
    <geom name="floor" type="plane" size="8 7 0.1" material="matfloor" condim="1"/>

    <geom name="wall_n" type="box" pos="0  6 0.5" size="7 0.3 0.5" material="matwall"/>
    <geom name="wall_s" type="box" pos="0 -6 0.5" size="7 0.3 0.5" material="matwall"/>
    <geom name="wall_e" type="box" pos=" 7 0 0.5" size="0.3 6 0.5" material="matwall"/>
    <geom name="wall_w" type="box" pos="-7 0 0.5" size="0.3 6 0.5" material="matwall"/>

    <!-- 中间隔墙：三个开口，宽度 0.7 / 1.4 / 2.4 m -->
    <geom name="seg0" type="box" pos="0 -4.775 0.5" size="0.15 1.225 0.5" material="matdiv"/>
    <geom name="seg1" type="box" pos="0 -1.775 0.5" size="0.15 1.075 0.5" material="matdiv"/>
    <geom name="seg2" type="box" pos="0  1.35  0.5" size="0.15 0.65  0.5" material="matdiv"/>
    <geom name="seg3" type="box" pos="0  5.2   0.5" size="0.15 0.80  0.5" material="matdiv"/>

    <!-- 差速车 -->
    <body name="robot" pos="0 0 0.12">
      <joint name="rx" type="slide" axis="1 0 0" damping="16" limited="true" range="-7.5 7.5"/>
      <joint name="ry" type="slide" axis="0 1 0" damping="16" limited="true" range="-6.5 6.5"/>
      <joint name="ryaw" type="hinge" axis="0 0 1" damping="4"/>

      <geom name="body" type="box" size="0.35 0.30 0.10" material="matrobot" density="180"/>
      <site name="lidar" pos="0 0 0.26" size="0.02" rgba="1 0 0 1"/>
      <site name="thr_l" pos="-0.30 -0.22 0" size="0.02"/>
      <site name="thr_r" pos="-0.30  0.22 0" size="0.02"/>
    </body>
  </worldbody>
</mujoco>
