<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gazebo_diff_drive_car</name>
  <version>0.1.0</version>
  <description>
    Gazebo 差速驱动小车物理仿真与多传感器闭环控制 ROS 2 功能包 —— 机器人操作系统及应用课程作业。

    基于 ROS 2 Humble 与 Gazebo 11，在自建差速底盘上实现：
      1) 物理仿真 + 键盘运动控制；
      2) 激光雷达感知 → 运动控制闭环避障；
      3) RGB-D 深度相机感知 → 运动控制闭环避障。

    机器人模型由 URDF/xacro 描述，底盘驱动与传感器数据由 gazebo_ros 插件提供，
    控制节点以 rclpy 实现，全部功能通过统一入口 launch 启动。
  </description>
  <maintainer email="xjm666god@users.noreply.github.com">xjm666god</maintainer>
  <license>MIT</license>

  <url type="repository">https://github.com/OpenHUTB/ros2</url>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
