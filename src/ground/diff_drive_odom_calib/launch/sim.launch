<launch>
  <!-- 只启动 MuJoCo 仿真节点。键盘另开一个终端：
         rosrun diff_drive_odom_calib teleop.py -->
  <arg name="scene" default=""/>
  <arg name="rate_hz" default="50.0"/>

  <node pkg="diff_drive_odom_calib" type="sim_node.py" name="sim_mujoco" output="screen">
    <param name="scene" value="$(arg scene)"/>
    <param name="rate_hz" value="$(arg rate_hz)"/>
    <param name="publish_tf" value="true"/>
  </node>
</launch>
