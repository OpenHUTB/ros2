<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="diff_car">
  <!-- 材质定义 -->
  <material name="blue">
    <color rgba="0 0 0.8 1"/>
  </material>
  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>
  <material name="red">
    <color rgba="0.8 0 0 1"/>
  </material>

  <!-- 车体参数 -->
  <xacro:property name="base_width" value="0.2"/>
  <xacro:property name="base_length" value="0.4"/>
  <xacro:property name="base_height" value="0.1"/>
  <xacro:property name="wheel_radius" value="0.06"/>
  <xacro:property name="wheel_width" value="0.03"/>
  <xacro:property name="ground_clearance" value="0.02"/>

  <!-- 底盘 base_link -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${ground_clearance + base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${ground_clearance + base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${ground_clearance + base_height/2}"/>
      <mass value="2.0"/>
      <inertia ixx="0.0083" iyy="0.0283" izz="0.033" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <gazebo reference="base_link">
    <selfCollide>false</selfCollide>
    <damping>
      <linear>0.1</linear>
      <angular>0.1</angular>
    </damping>
  </gazebo>

  <!-- 左后轮（驱动轮） -->
  <joint name="left_rear_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_rear_wheel"/>
    <origin xyz="${-base_length/2 + 0.05} ${base_width/2 + wheel_width/2} ${wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="30" velocity="10"/>
  </joint>
  <link name="left_rear_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0002175" iyy="0.00036" izz="0.0002175" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <!-- 右后轮（驱动轮） -->
  <joint name="right_rear_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_rear_wheel"/>
    <origin xyz="${-base_length/2 + 0.05} ${-base_width/2 - wheel_width/2} ${wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="30" velocity="10"/>
  </joint>
  <link name="right_rear_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0002175" iyy="0.00036" izz="0.0002175" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <!-- 左前轮：随动轮 continuous 自由旋转！！【修复重点】 -->
  <link name="left_front_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00011" iyy="0.00018" izz="0.00011" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>
  <joint name="left_front_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_front_wheel"/>
    <origin xyz="${base_length/2 - 0.05} ${base_width/2 + wheel_width/2} ${wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="0" velocity="10"/>
  </joint>

  <!-- 右前轮：随动轮 continuous 自由旋转！！【修复重点】 -->
  <link name="right_front_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00011" iyy="0.00018" izz="0.00011" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>
  <joint name="right_front_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_front_wheel"/>
    <origin xyz="${base_length/2 - 0.05} ${-base_width/2 - wheel_width/2} ${wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="0" velocity="10"/>
  </joint>

  <!-- 前相机 -->
  <joint name="front_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_camera"/>
    <origin xyz="${base_length/2 + 0.02} 0 ${ground_clearance + base_height + 0.02}" rpy="0 0 0"/>
  </joint>
  <link name="front_camera">
    <visual>
      <geometry>
        <box size="0.04 0.04 0.04"/>
      </geometry>
      <material name="red"/>
    </visual>
    <!-- 相机去掉collision，防止撞墙干扰 -->
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" iyy="0.00001" izz="0.00001" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <!-- 车轮摩擦接触参数 -->
  <gazebo reference="left_rear_wheel">
    <mu1>0.7</mu1>
    <mu2>0.1</mu2>
    <fdir1>1 0 0</fdir1>
    <kp>800000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>
  <gazebo reference="right_rear_wheel">
    <mu1>0.7</mu1>
    <mu2>0.1</mu2>
    <fdir1>1 0 0</fdir1>
    <kp>800000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>

  <gazebo reference="left_front_wheel">
    <mu1>0.4</mu1>
    <mu2>0.1</mu2>
    <fdir1>1 0 0</fdir1>
    <kp>800000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>
  <gazebo reference="right_front_wheel">
    <mu1>0.4</mu1>
    <mu2>0.1</mu2>
    <fdir1>1 0 0</fdir1>
    <kp>800000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>

  <!-- Gazebo差速驱动插件，轮距参数化，和模型匹配【修复重点】 -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <leftJoint>left_rear_wheel_joint</leftJoint>
      <rightJoint>right_rear_wheel_joint</rightJoint>

      <wheelDiameter>${2*wheel_radius}</wheelDiameter>
      <wheelSeparation>${base_width + wheel_width}</wheelSeparation>

      <wheelTorque>30</wheelTorque>
      <wheelAcceleration>10.0</wheelAcceleration>

      <updateRate>100</updateRate>
      <odometryTopic>/odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_link</robotBaseFrame>
      <legacyMode>false</legacyMode>
      <alwaysOn>true</alwaysOn>
      <publishWheelJointState>true</publishWheelJointState>
    </plugin>
  </gazebo>

  <!-- Gazebo相机插件 -->
  <gazebo reference="front_camera">
    <sensor type="camera" name="front_camera_sensor">
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>30</far>
        </clip>
      </camera>
      <always_on>true</always_on>
      <plugin name="front_camera_plugin" filename="libgazebo_ros_camera.so">
        <frameName>front_camera</frameName>
        <cameraName>front_camera</cameraName>
        <imageTopicName>/front_camera/image_raw</imageTopicName>
        <cameraInfoTopicName>/front_camera/camera_info</cameraInfoTopicName>
      </plugin>
    </sensor>
  </gazebo>

</robot>

