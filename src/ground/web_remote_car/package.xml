<?xml version="1.0"?>
<package format="2">
  <name>web_remote_car</name>
  <version>0.0.0</version>
  <description>Web ROS remote car with gazebo simulation, web_video_server and rosbridge</description>
  <maintainer email="2405640340@qq.com">xxx</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>rospy</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>gazebo_ros</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>roscpp</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <!-- 运行必须的两个包！！ -->
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>web_video_server</exec_depend>

  <export>
    <gazebo_ros />
  </export>
</package>

