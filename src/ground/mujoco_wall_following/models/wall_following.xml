<mujoco model="wall_following">
  <option timestep="0.005"/>
  <default>
    <joint armature="0.01"/>
    <geom condim="4"/>
  </default>
  <worldbody>
    <light pos="0 0 6" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="5 5 0.1" rgba="0.85 0.85 0.85 1" friction="1.0 0.1 0.1"/>
    <!-- 矩形闭环走廊外墙：内圈 x,y in [-1.9,1.9]，墙厚 0.1 m；size 的 z 为半高 0.25，故墙高 0.5 m（中心 z=0.25） -->
    <geom name="wall_south" type="box" pos="0.0 -1.95 0.25" size="2.0 0.05 0.25" rgba="0.5 0.5 0.5 1"/>
    <geom name="wall_north" type="box" pos="0.0 1.95 0.25" size="2.0 0.05 0.25" rgba="0.5 0.5 0.5 1"/>
    <geom name="wall_west"  type="box" pos="-1.95 0.0 0.25" size="0.05 2.0 0.25" rgba="0.5 0.5 0.5 1"/>
    <geom name="wall_east"  type="box" pos="1.95 0.0 0.25" size="0.05 2.0 0.25" rgba="0.5 0.5 0.5 1"/>
    <body name="chassis" pos="-1.45 -1.45 0.1">
      <freejoint/>
      <geom name="chassis" type="box" size="0.2 0.1 0.05" rgba="0.2 0.4 0.8 1"/>
      <inertial pos="0 0 0" mass="2.0" diaginertia="0.01 0.01 0.02"/>
      <!-- 后两轮：velocity 执行器驱动 -->
      <body name="left_wheel" pos="-0.08 0.11 -0.05">
        <joint name="left_wheel_joint" type="hinge" axis="0 1 0"/>
        <geom name="left_wheel" type="cylinder" fromto="0 -0.03 0 0 0.03 0" size="0.05" rgba="0.1 0.1 0.1 1" friction="1.0 0.1 0.1"/>
        <inertial pos="0 0 0" mass="0.1" diaginertia="0.0001 0.0001 0.0001"/>
      </body>
      <body name="right_wheel" pos="-0.08 -0.11 -0.05">
        <joint name="right_wheel_joint" type="hinge" axis="0 1 0"/>
        <geom name="right_wheel" type="cylinder" fromto="0 -0.03 0 0 0.03 0" size="0.05" rgba="0.1 0.1 0.1 1" friction="1.0 0.1 0.1"/>
        <inertial pos="0 0 0" mass="0.1" diaginertia="0.0001 0.0001 0.0001"/>
      </body>
      <!-- 前两轮：被动随动支撑，无执行器 -->
      <body name="front_left_wheel" pos="0.08 0.11 -0.05">
        <joint name="front_left_wheel_joint" type="hinge" axis="0 1 0"/>
        <geom name="front_left_wheel" type="cylinder" fromto="0 -0.03 0 0 0.03 0" size="0.05" rgba="0.3 0.3 0.3 1" friction="1.0 0.1 0.1"/>
        <inertial pos="0 0 0" mass="0.1" diaginertia="0.0001 0.0001 0.0001"/>
      </body>
      <body name="front_right_wheel" pos="0.08 -0.11 -0.05">
        <joint name="front_right_wheel_joint" type="hinge" axis="0 1 0"/>
        <geom name="front_right_wheel" type="cylinder" fromto="0 -0.03 0 0 0.03 0" size="0.05" rgba="0.3 0.3 0.3 1" friction="1.0 0.1 0.1"/>
        <inertial pos="0 0 0" mass="0.1" diaginertia="0.0001 0.0001 0.0001"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <velocity name="left_wheel" joint="left_wheel_joint" kv="2"/>
    <velocity name="right_wheel" joint="right_wheel_joint" kv="2"/>
  </actuator>
</mujoco>
