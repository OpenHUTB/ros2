<launch>
  <!-- 参数 -->
  <arg name="map_file" default="$(find turtlebot3_auto_nav)/maps/map.yaml"/>
  <arg name="use_sim_time" default="true" />

  <!-- 强制全局使用仿真时间 -->
  <param name="/use_sim_time" value="$(arg use_sim_time)" />

  <!-- map_server 加载静态地图 -->
  <node pkg="map_server" type="map_server" name="map_server" args="$(arg map_file)" output="screen">
    <param name="use_sim_time" value="$(arg use_sim_time)"/>
  </node>

  <!-- AMCL定位 -->
  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <param name="use_sim_time" value="$(arg use_sim_time)"/>
    <param name="transform_tolerance" value="1.0" />
    <param name="scan_topic" value="/scan"/>
    <param name="laser_frame_id" value="base_scan"/>
    <param name="base_frame_id" value="base_link"/>
    <param name="odom_frame_id" value="odom"/>
    <param name="min_particles" value="50"/>
    <param name="max_particles" value="2000"/>
    <param name="update_min_d" value="0.2"/>
    <param name="update_min_a" value="0.2"/>
  </node>

  <!-- move_base导航核心 -->
  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
    <param name="use_sim_time" value="$(arg use_sim_time)" />
    <param name="transform_tolerance" value="1.0" />
    <rosparam file="$(find turtlebot3_auto_nav)/param/costmap_common_params.yaml" command="load" ns="global_costmap"/>
    <rosparam file="$(find turtlebot3_auto_nav)/param/global_costmap_params.yaml" command="load"/>
    <rosparam file="$(find turtlebot3_auto_nav)/param/local_costmap_params.yaml" command="load"/>
    <rosparam file="$(find turtlebot3_auto_nav)/param/dwa_local_planner_params.yaml" command="load"/>
    
    <param name="base_local_planner" value="dwa_local_planner/DWAPlannerROS"/>
    <param name="base_global_planner" value="navfn/NavfnROS"/>
  </node>

  <!-- 自动启动 RViz 并加载配置 -->
  <node pkg="rviz" type="rviz" name="rviz" 
        args="-d $(find turtlebot3_auto_nav)/rviz/turtlebot3_nav.rviz" />
</launch>
