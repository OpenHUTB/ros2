<mujoco model="car_nn_scene_dual">
  <!-- 双障碍偏置：近障碍在左、远障碍在右。稳定驱动见 car_scene_basic.xml 顶部说明。 -->
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" iterations="60"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <default>
    <geom friction="1.0 0.005 0.0001" solref="0.02 1" solimp="0.9 0.95 0.001"/>
    <joint damping="0.05" armature="0.005"/>
    <default class="ego">
      <geom group="2"/>
    </default>
  </default>

  <worldbody>
    <geom name="floor" type="plane" size="0 0 0.05" rgba="0.30 0.32 0.34 1" group="1"/>

    <camera name="top" pos="3 0 8" fovy="60"/>

    <body name="obs1" pos="3.0 0.7 0.30">
      <geom name="obs1_geom" type="box" size="0.30 0.30 0.30" rgba="0.80 0.28 0.18 1" group="0"/>
    </body>
    <body name="obs2" pos="4.8 -0.7 0.30">
      <geom name="obs2_geom" type="box" size="0.30 0.30 0.30" rgba="0.80 0.28 0.18 1" group="0"/>
    </body>

    <body name="chassis" pos="0 0 0.048">
      <freejoint name="chassis_root"/>
      <geom name="chassis_body" class="ego" type="box" pos="0.04 0 0.04"
            size="0.22 0.12 0.035" rgba="0.20 0.45 0.85 1" mass="4.0"/>
      <geom name="caster" class="ego" type="sphere" pos="0.16 0 -0.02" size="0.03"
            friction="0.005 0.005 0.0001" mass="0.05" rgba="0.30 0.30 0.30 1"/>
      <geom name="caster_rear" class="ego" type="sphere" pos="-0.16 0 -0.012" size="0.03"
            friction="0.005 0.005 0.0001" mass="0.05" rgba="0.30 0.30 0.30 1"/>
      <site name="lidar" pos="0.22 0 0.06" size="0.012" rgba="1 1 0 1" group="3"/>

      <body name="wheel_l" pos="0 0.125 0">
        <joint name="wheel_l_joint" type="hinge" axis="0 1 0"/>
        <geom name="wheel_l_geom" class="ego" type="cylinder" friction="1.2 0.01 0.0001"
              size="0.05 0.025" euler="1.5707963 0 0" mass="0.25" rgba="0.08 0.08 0.08 1"/>
      </body>
      <body name="wheel_r" pos="0 -0.125 0">
        <joint name="wheel_r_joint" type="hinge" axis="0 1 0"/>
        <geom name="wheel_r_geom" class="ego" type="cylinder" friction="1.2 0.01 0.0001"
              size="0.05 0.025" euler="1.5707963 0 0" mass="0.25" rgba="0.08 0.08 0.08 1"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <velocity name="drive_l" joint="wheel_l_joint" kv="10" ctrlrange="-60 60" forcerange="-8 8"/>
    <velocity name="drive_r" joint="wheel_r_joint" kv="10" ctrlrange="-60 60" forcerange="-8 8"/>
  </actuator>
</mujoco>
