<mujoco model="traffic_scene">
  <option timestep="0.02"/>
  <default>
    <geom solref="0.03 1.2" solimp="0.9 0.98 0.01"/>
  </default>
  <worldbody>
    <light pos="0 0 8" dir="0 0 -1"/>
    <geom name="ground" type="plane" size="12 6 0.1" rgba="0.3 0.3 0.3 1" friction="1.2 0.1 0.1"/>
    <geom name="stop_line" type="box" pos="2 0 0.001" size="0.01 2.5 0.002" rgba="0 0 0 1" contype="0" conaffinity="0"/>

    <body name="light_pole" pos="3 0 0.8">
      <geom type="cylinder" size="0.05 0.8" rgba="0.2 0.2 0.2 1"/>
      <geom name="light_red" type="sphere" pos="0 0 0.3" size="0.10" rgba="0.8 0 0 1"/>
      <geom name="light_yellow" type="sphere" pos="0 0 0.0" size="0.10" rgba="0.8 0.8 0 1"/>
      <geom name="light_green" type="sphere" pos="0 0 -0.3" size="0.10" rgba="0 0.8 0 1"/>
    </body>

    <body name="car" pos="-6 0 0.05">
      <joint name="car_joint" type="slide" axis="1 0 0" damping="0.8"/>
      <geom type="box" size="0.25 0.18 0.04" rgba="0.1 0.4 0.8 1" mass="1.2"/>
    </body>
  </worldbody>
  <actuator>
    <motor name="drive" joint="car_joint" gear="1.0"/>
  </actuator>
</mujoco>
