<?xml version="1.0"?>
<package format="2">
  <name>mujoco_multi_goal_nav</name>
  <version>0.0.0</version>
  <description>MuJoCo 小车多目标导航：小车依次到达三个目标点，平面速度闭环 + 姿态锁定，入口 main.py</description>
  <maintainer email="352797580@qq.com">Ri-kin08</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- MuJoCo 与 numpy 由 pip 安装（pip3 install -r requirements.txt），不在 rosdep 中，
       故此处只声明系统 Python，避免 rosdep 解析 mujoco 依赖时报 unknown package -->
  <exec_depend>python3</exec_depend>
</package>
