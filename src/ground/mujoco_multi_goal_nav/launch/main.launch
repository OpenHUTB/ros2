<launch>
  <!--
    main.launch —— MuJoCo 小车多目标导航（ROS 1 / Noetic）

    默认带窗口运行。无显示器环境改用：roslaunch mujoco_multi_goal_nav main.launch nogui:=true
    运行前：cd ~/catkin_ws && catkin_make && source devel/setup.bash
  -->
  <arg name="nogui" default="false"/>
  <arg name="duration" default="40"/>

  <node pkg="mujoco_multi_goal_nav" type="main.py" name="mujoco_multi_goal_nav"
        output="screen" required="true"
        args="--duration $(arg duration) $(eval '--nogui' if arg('nogui') else '')"/>
</launch>
