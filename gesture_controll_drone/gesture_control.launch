<launch>
    <!-- 启动手势感知节点 -->
    <node name="gesture_ros_node" pkg="gesture_controll_drone" type="scripts/gesture_ros_node.py" output="screen" />
    
    <!-- 启动无人机控制节点 -->
    <node name="drone_control_node" pkg="gesture_controll_drone" type="scripts/drone_control_node.py" output="screen" />
</launch>
