<?xml version="1.0"?>
<sdf version="1.6">
<world name="delivery_world">
  <include>
    <uri>model://ground_plane</uri>
  </include>
  <include>
    <uri>model://sun</uri>
  </include>

  <!-- 障碍物墙体 -->
  <model name="wall1">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>2 0.2 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>2 0.2 1</size></box></geometry>
      </visual>
      <pose>1.5 1.0 0.5 0 0 0</pose>
    </link>
  </model>

  <model name="wall2">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.2 3 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.2 3 1</size></box></geometry>
      </visual>
      <pose>-1.0 0 0.5 0 0 0</pose>
    </link>
  </model>
</world>
</sdf>

