[32m+[m[32m# 方式3：直接python调试运行[m
[32m+[m[32mpython3 scripts/main.py[m
[32m+[m[32m```[m
[32m+[m[32m## 5 运行效果[m
[32m+[m
[32m+[m[32m仿真现象：[m
[32m+[m
[32m+[m[32m- 仿真初期自车匀速向前行驶，前车保持静止，TTC 数值持续下降；[m
[32m+[m[32m- TTC 下降至设定安全阈值后 AEB 系统触发，输出平滑增大的制动力，自车开始减速；[m
