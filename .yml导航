[32m+[m[32mclass AEBController:[m
[32m+[m[32m    def __init__(self, ttc_threshold=5.0, gain=1.4, v_stop=0.1):[m
[32m+[m[32m        # 参数全部外部可配置，和main脚本统一[m
[32m+[m[32m        self.ttc_threshold = ttc_threshold[m
[32m+[m[32m        self.gain = gain[m
[32m+[m[32m        self.v_stop = v_stop[m
[32m+[m
[32m+[m[32m    def get_brake(self, ttc: float, v_ego: float) -> float:[m
[32m+[m[32m        """[m
[32m+[m[32m        :param ttc: TTC碰撞时间(s)，无风险一般传入99[m
[32m+[m[32m        :param v_ego: 自车速度 m/s[m
[32m+[m[32m        :return: brake 0~1[m
[32m+[m[32m        """[m
[32m+[m[32m        # 低速保护，速度过小不制动[m
[32m+[m[32m        if abs(v_ego) < self.v_stop:[m
[32m+[m[32m            return 0.0[m
[32m+[m
[32m+[m[32m        # TTC异常/无碰撞风险[m
[32m+[m[32m        if ttc >= self.ttc_threshold or ttc <= 0:[m
[32m+[m[32m            return 0.0[m
[32m+[m
[32m+[m[32m        # 比例制动计算，带gain增益，限幅0‑1[m
[32m+[m[32m        raw_brake = self.gain * (1.0 - ttc / self.ttc_threshold)[m
[32m+[m[32m        brake = np.clip(raw_brake, 0.0, 1.0)[m
[32m+[m[32m        return float(brake)[m
