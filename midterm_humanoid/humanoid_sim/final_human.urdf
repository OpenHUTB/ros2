<?xml version="1.0"?>
<robot name="human_robot">
  <!--躯干-->
  <link name="base_link">
    <visual>
      <geometry><box size="0.3 0.2 0.4"/></geometry>
      <material name="blue"><color rgba="0 0 0.8 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.3 0.2 0.4"/></geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>

  <!--头部-->
  <link name="head">
    <visual>
      <geometry><sphere radius="0.15"/></geometry>
      <material name="white"><color rgba="1 1 1 1"/></material>
    </visual>
    <collision>
      <geometry><sphere radius="0.15"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>
  <joint name="joint_head" type="fixed">
    <parent link="base_link"/>
    <child link="head"/>
    <origin xyz="0 0 0.35" rpy="0 0 0"/>
  </joint>

  <!--左臂-->
  <link name="left_arm">
    <visual>
      <geometry><box size="0.25 0.08 0.08"/></geometry>
      <material name="gray"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.25 0.08 0.08"/></geometry>
    </collision>
    <inertial>
      <mass value="0.6"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
  </link>
  <joint name="joint_left_arm" type="fixed">
    <parent link="base_link"/>
    <child link="left_arm"/>
    <origin xyz="-0.28 0 0.15" rpy="0 0 0"/>
  </joint>

  <!--右臂-->
  <link name="right_arm">
    <visual>
      <geometry><box size="0.25 0.08 0.08"/></geometry>
      <material name="gray"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.25 0.08 0.08"/></geometry>
    </collision>
    <inertial>
      <mass value="0.6"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
  </link>
  <joint name="joint_right_arm" type="fixed">
    <parent link="base_link"/>
    <child link="right_arm"/>
    <origin xyz="0.28 0 0.15" rpy="0 0 0"/>
  </joint>

  <!--左腿-->
  <link name="left_leg">
    <visual>
      <geometry><box size="0.08 0.08 0.35"/></geometry>
      <material name="black"><color rgba="0 0 0 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.08 0.08 0.35"/></geometry>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.03"/>
    </inertial>
  </link>
  <joint name="joint_left_leg" type="fixed">
    <parent link="base_link"/>
    <child link="left_leg"/>
    <origin xyz="-0.12 0 -0.38" rpy="0 0 0"/>
  </joint>

  <!--右腿-->
  <link name="right_leg">
    <visual>
      <geometry><box size="0.08 0.08 0.35"/></geometry>
      <material name="black"><color rgba="0 0 0 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.08 0.08 0.35"/></geometry>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.03"/>
    </inertial>
  </link>
  <joint name="joint_right_leg" type="fixed">
    <parent link="base_link"/>
    <child link="right_leg"/>
    <origin xyz="0.12 0 -0.38" rpy="0 0 0"/>
  </joint>
</robot>