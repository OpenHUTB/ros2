<launch>
  <!-- 任务4 · CARLA 端到端 CNN（ROS1 Noetic）
       用法： roslaunch carla_assignment 04.launch mode:=test -->
  <arg name="host" default="127.0.0.1"/>
  <arg name="port" default="2000"/>
  <arg name="town" default="Town05"/>
  <arg name="mode" default="test"/>
  <arg name="frames" default="200"/>
  <arg name="epochs" default="30"/>
  <arg name="out_dir" default="dataset"/>
  <arg name="data_dir" default="dataset"/>
  <arg name="model_path" default="models/cnn.h5"/>
  <arg name="backend" default="tf"/>
  <arg name="sim_time" default="10.0"/>

  <node name="carla_end_to_end_node" pkg="carla_assignment" type="python3"
        output="screen"
        args="$(find carla_assignment)/04_end_to_end/main.py
              --host $(arg host) --port $(arg port) --town $(arg town)
              --mode $(arg mode) --frames $(arg frames) --epochs $(arg epochs)
              --out_dir $(arg out_dir) --data_dir $(arg data_dir)
              --model_path $(arg model_path) --backend $(arg backend)
              --sim_time $(arg sim_time)" />
</launch>
