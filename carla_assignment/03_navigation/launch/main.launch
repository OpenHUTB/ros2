<launch>
  <!-- 任务3 · CARLA 建图 + 导航（神经网络版）（ROS1 Noetic 语法）
       用法： source /opt/ros/noetic/setup.bash
              roslaunch carla_assignment 03_navigation.launch mode:=run goal:="20,8"
       需先启动 CARLA 服务端：./CarlaUE4.sh -carla-rpc-port=2000 -->

  <arg name="host" default="127.0.0.1"/>
  <arg name="port" default="2000"/>
  <arg name="town" default="Town05"/>
  <arg name="mode" default="run"/>
  <arg name="model" default="models/nn_plan.json"/>
  <arg name="goal" default="20,8"/>
  <arg name="sim_time" default="25.0"/>

  <node name="carla_mapping_nav_node" pkg="carla_assignment" type="python3"
        output="screen"
        args="$(find carla_assignment)/03_navigation/main.py
              --host $(arg host) --port $(arg port) --town $(arg town)
              --mode $(arg mode) --model $(arg model)
              --goal $(arg goal) --sim_time $(arg sim_time)" />
</launch>
