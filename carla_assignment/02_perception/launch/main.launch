<launch>
  <!-- 任务2 · CARLA 感知 + 轨迹跟踪（神经网络版）（ROS1 Noetic 语法）
       用法： source /opt/ros/noetic/setup.bash
              roslaunch carla_assignment 02_perception.launch mode:=run
       需先启动 CARLA 服务端：./CarlaUE4.sh -carla-rpc-port=2000 -->

  <arg name="host" default="127.0.0.1"/>
  <arg name="port" default="2000"/>
  <arg name="town" default="Town05"/>
  <arg name="mode" default="run"/>
  <arg name="model" default="models/nn_percept.json"/>
  <arg name="waypoints" default="40,-8 40,12 25,20"/>
  <arg name="sim_time" default="25.0"/>

  <node name="carla_perception_node" pkg="carla_assignment" type="python3"
        output="screen"
        args="$(find carla_assignment)/02_perception/main.py
              --host $(arg host) --port $(arg port) --town $(arg town)
              --mode $(arg mode) --model $(arg model)
              --waypoints '$(arg waypoints)' --sim_time $(arg sim_time)" />
</launch>
