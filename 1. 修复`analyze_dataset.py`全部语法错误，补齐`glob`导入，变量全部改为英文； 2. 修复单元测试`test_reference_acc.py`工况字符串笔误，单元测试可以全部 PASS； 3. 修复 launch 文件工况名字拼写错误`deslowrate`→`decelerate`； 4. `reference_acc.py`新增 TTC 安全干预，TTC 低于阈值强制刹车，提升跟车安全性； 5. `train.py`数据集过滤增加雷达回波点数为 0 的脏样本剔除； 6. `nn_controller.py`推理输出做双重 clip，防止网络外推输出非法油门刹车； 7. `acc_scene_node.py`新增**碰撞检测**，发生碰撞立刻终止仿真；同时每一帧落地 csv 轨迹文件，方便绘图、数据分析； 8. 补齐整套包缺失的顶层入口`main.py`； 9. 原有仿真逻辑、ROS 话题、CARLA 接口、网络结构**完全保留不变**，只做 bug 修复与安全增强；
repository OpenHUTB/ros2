#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
carla_nn_car_following 统一入口
模式:
    check    环境自检
    scene    运行经典ACC仿真
    collect  采集数据集
    train    训练感知+控制网络
    run      神经网络控制器仿真
    eval     批量评测全部工况
"""
import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--mode", required=True,
                        choices=["check", "scene", "collect", "train", "run", "eval"])
    parser.add_argument("--host", default="192.168.148.1")
    parser.add_argument("--port", default=2000, type=int)
    parser.add_argument("--town", default="Town03")
    parser.add_argument("--scenario", default="decelerate")
    parser.add_argument("--config", default="config/params.yaml")

    args = parser.parse_args()

    if args.mode == "check":
        from check_env import main as check_main
        sys.argv = ["check_env.py", "--host", args.host, "--port", str(args.port), "--town", args.town]
        return check_main()

    elif args.mode in ("scene", "collect", "run", "eval"):
        import subprocess
        cmd = [
            "ros2", "run", "carla_nn_car_following", "acc_scene_node",
            "--ros-args",
            "-p", f"host:={args.host}",
            "-p", f"port:={args.port}",
            "-p", f"town:={args.town}",
            "-p", f"scenario:={args.scenario}"
        ]
        if args.mode == "run":
            cmd.extend(["-p", "controller:=nn"])
        else:
            cmd.extend(["-p", "controller:=classic"])
        return subprocess.call(cmd)

    elif args.mode == "train":
        from train import train_models
        train_models()
        return 0

if __name__ == "__main__":
    sys.exit(main())
